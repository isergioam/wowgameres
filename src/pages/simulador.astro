---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
	title="Nexo Craft: Simulador de Oro & IA – WOWGamerES" 
	description="Calculadora avanzada de oro en tiempo real para World of Warcraft, optimizador de especializaciones de profesión y asistente táctico IA."
>
	<div class="lab-container">
		<!-- Header Hero de la Suite -->
		<header class="lab-hero">
			<div class="lab-badge">
				<span class="pulse-dot"></span>
				<span>NEXO CRAFT v2.0 — WOWGAMERES</span>
			</div>
			<h1 class="lab-title">Nexo Craft: Simulador de Oro & IA</h1>
			<p class="lab-subtitle">
				Calcula tus beneficios en subasta, optimiza tus talentos de profesión y consulta a la IA en tiempo real.
			</p>

			<!-- Navegación por Pestañas de Alta Legibilidad -->
			<div class="lab-controls">
				<div class="mode-buttons" role="tablist" aria-label="Navegación de herramientas">
					<button class="mode-btn active" data-mode="simulator" role="tab" aria-selected="true" id="btn-mode-simulator">
						<span class="btn-icon">💎</span> Simulador de Oro
					</button>
					<button class="mode-btn" data-mode="talents" role="tab" aria-selected="false" id="btn-mode-talents">
						<span class="btn-icon">🎓</span> Talentos & Especializaciones
					</button>
					<button class="mode-btn" data-mode="ai" role="tab" aria-selected="false" id="btn-mode-ai">
						<span class="btn-icon">🧠</span> Asistente IA Nexo
					</button>
				</div>
				<div class="sound-toggle-wrapper">
					<button id="sound-toggle-btn" class="sound-btn" title="Activar o desactivar efectos de audio">
						<span id="sound-icon">🔊</span> Audio: <strong id="sound-status">ACTIVADO</strong>
					</button>
				</div>
			</div>
		</header>

		<!-- PESTAÑA 1: SIMULADOR DE ORO Y RENTABILIDAD EN TIEMPO REAL -->
		<section id="view-simulator" class="lab-view active-view">
			<div class="sim-grid">
				<!-- Panel de Parámetros e Entradas -->
				<div class="sim-card sim-controls-card">
					<div class="card-header-block">
						<span class="card-step-badge">PASO 1</span>
						<h2>⚙️ Parámetros de Mercado</h2>
					</div>
					<p class="card-intro-text">
						Ajusta la profesión y los valores para calcular tu beneficio neto al instante.
					</p>
					
					<!-- Selección de Profesión y Receta -->
					<div class="sim-input-group">
						<label for="input-prof-type" class="input-title">Profesión Principal:</label>
						<select id="input-prof-type" class="sim-select">
							<option value="alquimia">🧪 Alquimia – Frascos y Pociones Míticas</option>
							<option value="herreria">⚒️ Herrería – Armaduras Épicas y Placas</option>
							<option value="herboristeria">🌿 Herboristería – Ruta de Recolección</option>
							<option value="encantamiento">✨ Encantamiento – Velos y Cintas de Arma</option>
							<option value="joyeria">💎 Joyería – Engaste de Gemas</option>
						</select>
					</div>

					<div class="sim-input-group">
						<label for="input-recipe-type" class="input-title">Receta u Objeto a Producir:</label>
						<select id="input-recipe-type" class="sim-select">
							<option value="frasco_agilidad">Frasco de Agilidad Arcana (Calidad 3)</option>
							<option value="pocion_poder">Poción de Poder Explosivo (Calidad 3)</option>
							<option value="lote_transmutacion">Transmutación de Piedras de Sangre</option>
						</select>
					</div>

					<!-- Sliders de Control -->
					<div class="sim-input-group">
						<div class="label-row">
							<label for="range-hours" class="input-title">Tiempo de Trabajo Diario:</label>
							<span id="val-hours" class="badge-val">2.5 horas</span>
						</div>
						<input type="range" id="range-hours" min="0.5" max="8" step="0.5" value="2.5" aria-label="Tiempo de trabajo diario" />
					</div>

					<div class="sim-input-group">
						<div class="label-row">
							<label for="range-multicraft" class="input-title">Tasa de Multicraft / Procs Extra (%):</label>
							<span id="val-multicraft" class="badge-val">28%</span>
						</div>
						<input type="range" id="range-multicraft" min="0" max="60" step="1" value="28" aria-label="Tasa de multicraft" />
					</div>

					<div class="sim-input-group">
						<div class="label-row">
							<label for="range-mat-cost" class="input-title">Coste de Materiales (Oro/Unidad):</label>
							<span id="val-mat-cost" class="badge-val">110g</span>
						</div>
						<input type="range" id="range-mat-cost" min="10" max="800" step="5" value="110" aria-label="Coste de materiales" />
					</div>

					<div class="sim-input-group">
						<div class="label-row">
							<label for="range-sell-price" class="input-title">Precio de Venta en Subasta (Oro/Unidad):</label>
							<span id="val-sell-price" class="badge-val">340g</span>
						</div>
						<input type="range" id="range-sell-price" min="20" max="1500" step="10" value="340" aria-label="Precio de venta en subasta" />
					</div>

					<div class="sync-banner">
						<span class="sync-icon">⚡</span>
						<span class="sync-text">Bonus de Talentos: <strong id="talent-bonus-indicator" class="highlight-cyan">+12% Multicraft (-8% Mats)</strong></span>
					</div>
				</div>

				<!-- Panel de Resultados Financieros -->
				<div class="sim-card sim-results-card">
					<div class="card-header-block">
						<span class="card-step-badge step-success">PASO 2</span>
						<h2>💰 Balance Estimado</h2>
					</div>

					<div class="primary-result-box">
						<span class="result-label-title">BENEFICIO NETO DIARIO ESTIMADO</span>
						<div class="big-gold-counter" id="total-gold-counter">68.400g</div>
						<span class="sub-counter-label" id="hourly-gold-counter">~27.360g por hora activa</span>
					</div>

					<div class="result-breakdown">
						<div class="breakdown-item">
							<span class="breakdown-label">Ingresos Brutos en Subasta:</span>
							<strong id="res-gross" class="val-positive">114.240g</strong>
						</div>
						<div class="breakdown-item">
							<span class="breakdown-label">Gastos Totales en Materiales:</span>
							<strong id="res-costs" class="val-negative">40.128g</strong>
						</div>
						<div class="breakdown-item">
							<span class="breakdown-label">Comisión de Subasta (5%):</span>
							<strong id="res-tax" class="val-warning">5.712g</strong>
						</div>
						<div class="breakdown-item highlight-row">
							<span class="breakdown-label">Retorno Neto sobre Inversión (ROI):</span>
							<strong id="res-roi" class="val-roi">+170%</strong>
						</div>
					</div>

					<div class="visual-progress-wrapper">
						<div class="bar-header">
							<span>Margen de Ganancia Libre</span>
							<strong id="bar-percentage-label" class="bar-percentage">70%</strong>
						</div>
						<div class="visual-progress-bar">
							<div class="bar-fill" id="roi-bar" style="width: 70%;"></div>
						</div>
					</div>

					<div class="quick-action-box">
						<button id="btn-consult-ai-sim" class="btn-primary-action">
							🤖 Consultar a IA Nexo cómo maximizar esta ganancia →
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- PESTAÑA 2: ÁRBOL INTERACTIVO DE ESPECIALIZACIONES & TALENTOS -->
		<section id="view-talents" class="lab-view">
			<div class="talents-container">
				<div class="talents-header">
					<div class="talents-title-block">
						<h2>🎓 Talentos & Especializaciones</h2>
						<p>Distribuye tus puntos de conocimiento para potenciar tu multicraft y ahorrar insumos.</p>
					</div>
					<div class="points-budget">
						<span class="points-label">Puntos Disponibles:</span>
						<strong id="points-counter" class="points-badge">40 / 50 Puntos</strong>
					</div>
				</div>

				<!-- Grid de Nodos de Talentos -->
				<div class="talents-grid">
					<div class="talent-card">
						<div class="talent-icon-wrap">🧪</div>
						<div class="talent-content">
							<h3>Maestría en Multicraft</h3>
							<p>Aumenta la probabilidad de elaborar pociones y frascos adicionales por cada fabricación.</p>
							<div class="talent-stats">
								<span>Efecto activo: <strong class="highlight-cyan" id="stat-multicraft">+12% Multicraft</strong></span>
							</div>
							<div class="talent-controls">
								<button class="btn-point btn-sub" data-target="multicraft" title="Restar punto">-</button>
								<span class="point-value" id="val-talent-multicraft">12 Pts</span>
								<button class="btn-point btn-add" data-target="multicraft" title="Añadir punto">+</button>
							</div>
						</div>
					</div>

					<div class="talent-card">
						<div class="talent-icon-wrap">🌿</div>
						<div class="talent-content">
							<h3>Eficiencia de Insumos</h3>
							<p>Reduce la cantidad de hierbas raras requeridas para la confección de consumibles míticos.</p>
							<div class="talent-stats">
								<span>Efecto activo: <strong class="highlight-green" id="stat-frugality">-8% Ahorro de Insumos</strong></span>
							</div>
							<div class="talent-controls">
								<button class="btn-point btn-sub" data-target="frugality" title="Restar punto">-</button>
								<span class="point-value" id="val-talent-frugality">8 Pts</span>
								<button class="btn-point btn-add" data-target="frugality" title="Añadir punto">+</button>
							</div>
						</div>
					</div>

					<div class="talent-card">
						<div class="talent-icon-wrap">✨</div>
						<div class="talent-content">
							<h3>Inspiración Mítica</h3>
							<p>Incrementa la probabilidad de obtener artículos de máxima calidad (Rango 3) con insumos base.</p>
							<div class="talent-stats">
								<span>Efecto activo: <strong class="highlight-gold" id="stat-inspiration">+10% Calidad Máxima</strong></span>
							</div>
							<div class="talent-controls">
								<button class="btn-point btn-sub" data-target="inspiration" title="Restar punto">-</button>
								<span class="point-value" id="val-talent-inspiration">10 Pts</span>
								<button class="btn-point btn-add" data-target="inspiration" title="Añadir punto">+</button>
							</div>
						</div>
					</div>

					<div class="talent-card">
						<div class="talent-icon-wrap">⚡</div>
						<div class="talent-content">
							<h3>Celeridad de Elaboración</h3>
							<p>Aumenta la velocidad de fabricación en lote para procesar cientos de ítems en segundos.</p>
							<div class="talent-stats">
								<span>Efecto activo: <strong class="highlight-violet" id="stat-speed">+0% Velocidad</strong></span>
							</div>
							<div class="talent-controls">
								<button class="btn-point btn-sub" data-target="speed" title="Restar punto">-</button>
								<span class="point-value" id="val-talent-speed">0 Pts</span>
								<button class="btn-point btn-add" data-target="speed" title="Añadir punto">+</button>
							</div>
						</div>
					</div>
				</div>

				<div class="talents-footer-banner">
					<div class="banner-text">
						💡 <strong>Sincronización activa:</strong> Tus puntos de conocimiento se aplican de forma inmediata al Simulador de Oro.
					</div>
					<button id="btn-apply-to-sim" class="btn-apply">Ver en el Simulador de Oro ➔</button>
				</div>
			</div>
		</section>

		<!-- PESTAÑA 3: ASISTENTE IA NEXO TÁCTICO -->
		<section id="view-ai" class="lab-view">
			<div class="ai-widget-wrapper">
				<div class="ai-header">
					<div class="ai-avatar">
						<span class="avatar-orb"></span>
						<span class="avatar-icon">🧠</span>
					</div>
					<div class="ai-title-block">
						<h2>Asistente Táctico IA Nexo</h2>
						<p>Consultor inteligente en tiempo real entrenado en economía, profesiones y rutas de Azeroth.</p>
					</div>
					<div class="ai-status">
						<span class="status-indicator"></span>
						<span>Online y Conectado</span>
					</div>
				</div>

				<div class="ai-quick-prompts">
					<span class="prompts-label">Consultas frecuentes:</span>
					<button class="quick-btn" data-prompt="¿Cuál es la receta de Alquimia que más margen de oro deja hoy?">🧪 Receta de Oro Top</button>
					<button class="quick-btn" data-prompt="¿Cómo debo distribuir mis 50 puntos de conocimiento en Alquimia?">🎓 Distribución de Puntos</button>
					<button class="quick-btn" data-prompt="¿Cuándo es el mejor día para poner a la venta consumibles en la Casa de Subastas?">📈 Estrategia de Subasta</button>
				</div>

				<div class="ai-chat-box" id="ai-chat-box">
					<div class="chat-message msg-ai">
						<div class="msg-author">Nexo IA</div>
						<div class="msg-content">
							¡Saludos, aventurero! He sincronizado los datos de tu <strong>Simulador de Oro</strong> y tu <strong>Árbol de Talentos</strong>. 
							Actualmente simulas <strong>Alquimia</strong> con un beneficio proyectado de <strong class="highlight-gold">68.400g/día</strong>. ¿En qué te gustaría profundizar hoy?
						</div>
					</div>
				</div>

				<form id="ai-chat-form" class="ai-input-form">
					<input type="text" id="ai-user-input" placeholder="Escribe tu consulta sobre profesiones, oro o recetas..." autocomplete="off" required />
					<button type="submit" class="ai-send-btn">
						<span>Enviar</span>
						<span class="send-arrow">➔</span>
					</button>
				</form>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	/* ==========================================================================
	   ESTILOS DE 1 SOLA LÍNEA, ALTO CONSTRASTE Y ALTA LEGIBILIDAD
	   ========================================================================== */

	.lab-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 1.5rem 1rem 5rem 1rem;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}

	/* --- MODO CLARO (POR DEFECTO EN HTML:NOT(.DARK-MODE)) --- */
	html:not(.dark-mode) .lab-container {
		--bg-hero: #ffffff;
		--border-hero: #cbd5e1;
		--title-color: #0f172a;
		--subtitle-color: #334155;
		--badge-bg: #e0e7ff;
		--badge-border: #6366f1;
		--badge-text: #3730a3;
		
		--controls-bg: #f8fafc;
		--controls-border: #cbd5e1;
		--btn-inactive-text: #334155;
		--btn-inactive-hover: #e2e8f0;

		--card-bg: #ffffff;
		--card-border: #cbd5e1;
		--card-title: #0f172a;
		--card-text: #334155;

		--input-bg: #f8fafc;
		--input-border: #cbd5e1;
		--input-text: #0f172a;
		--val-badge-bg: #e0f2fe;
		--val-badge-border: #0284c7;
		--val-badge-text: #0369a1;

		--result-box-bg: #fef3c7;
		--result-box-border: #f59e0b;
		--result-counter-color: #b45309;
		--breakdown-bg: #f8fafc;
		--breakdown-border: #e2e8f0;
		--breakdown-text: #1e293b;

		--chat-bg: #f8fafc;
		--msg-ai-bg: #f1f5f9;
		--msg-ai-border: #cbd5e1;
		--msg-ai-text: #0f172a;

		--hl-cyan: #0284c7;
		--hl-green: #059669;
		--hl-gold: #b45309;
		--hl-violet: #7c3aed;
	}

	/* --- MODO OSCURO (HTML.DARK-MODE) --- */
	html.dark-mode .lab-container {
		--bg-hero: linear-gradient(135deg, rgba(30, 27, 75, 0.8), rgba(15, 23, 42, 0.9));
		--border-hero: rgba(99, 102, 241, 0.4);
		--title-color: #ffffff;
		--subtitle-color: #cbd5e1;
		--badge-bg: rgba(99, 102, 241, 0.25);
		--badge-border: #818cf8;
		--badge-text: #e0e7ff;

		--controls-bg: #0f172a;
		--controls-border: #334155;
		--btn-inactive-text: #94a3b8;
		--btn-inactive-hover: rgba(255, 255, 255, 0.08);

		--card-bg: #111625;
		--card-border: #334155;
		--card-title: #ffffff;
		--card-text: #e2e8f0;

		--input-bg: #0f172a;
		--input-border: #475569;
		--input-text: #ffffff;
		--val-badge-bg: #1e293b;
		--val-badge-border: #0284c7;
		--val-badge-text: #38bdf8;

		--result-box-bg: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(180, 83, 9, 0.25));
		--result-box-border: #f59e0b;
		--result-counter-color: #fbbf24;
		--breakdown-bg: rgba(255, 255, 255, 0.04);
		--breakdown-border: rgba(255, 255, 255, 0.08);
		--breakdown-text: #e2e8f0;

		--chat-bg: #0f172a;
		--msg-ai-bg: #1e293b;
		--msg-ai-border: #475569;
		--msg-ai-text: #f8fafc;

		--hl-cyan: #38bdf8;
		--hl-green: #34d399;
		--hl-gold: #fbbf24;
		--hl-violet: #c084fc;
	}

	/* Hero Header */
	.lab-hero {
		text-align: center;
		margin-bottom: 2rem;
		padding: 2.2rem 1.5rem;
		background: var(--bg-hero);
		border-radius: 24px;
		border: 2px solid var(--border-hero);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
	}

	.lab-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--badge-bg);
		border: 1.5px solid var(--badge-border);
		color: var(--badge-text);
		padding: 0.45rem 1.2rem;
		border-radius: 9999px;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
	}

	.pulse-dot {
		width: 10px;
		height: 10px;
		background-color: #06b6d4;
		border-radius: 50%;
		box-shadow: 0 0 12px #06b6d4;
		animation: pulse-glow 1.5s infinite alternate;
	}

	@keyframes pulse-glow {
		from { opacity: 0.5; transform: scale(0.9); }
		to { opacity: 1; transform: scale(1.3); }
	}

	.lab-title {
		font-size: clamp(2rem, 3.8vw, 3rem);
		font-weight: 900;
		color: var(--title-color);
		margin-bottom: 0.8rem;
		line-height: 1.15;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		.lab-title {
			white-space: normal;
		}
	}

	.lab-subtitle {
		font-size: 1.1rem;
		color: var(--subtitle-color);
		max-width: 820px;
		margin: 0 auto 1.8rem auto;
		line-height: 1.5;
		font-weight: 500;
	}

	/* Controls / Bar */
	.lab-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background: var(--controls-bg);
		padding: 0.6rem;
		border-radius: 20px;
		border: 1.5px solid var(--controls-border);
	}

	.mode-buttons {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.mode-btn {
		background: transparent;
		border: 1.5px solid transparent;
		color: var(--btn-inactive-text);
		padding: 0.75rem 1.4rem;
		border-radius: 14px;
		font-weight: 700;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.mode-btn:hover {
		background: var(--btn-inactive-hover);
	}

	.mode-btn.active {
		background: #2563eb;
		border-color: #60a5fa;
		color: #ffffff !important;
		box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
	}

	.sound-btn {
		background: var(--controls-bg);
		border: 1.5px solid var(--controls-border);
		color: var(--title-color);
		padding: 0.65rem 1.1rem;
		border-radius: 12px;
		cursor: pointer;
		font-size: 0.9rem;
		font-weight: 700;
	}

	/* Tabs */
	.lab-view {
		display: none;
		opacity: 0;
		transition: opacity 0.25s ease;
	}

	.lab-view.active-view {
		display: block;
		opacity: 1;
	}

	/* Grid & Cards */
	.sim-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	@media (max-width: 960px) {
		.sim-grid {
			grid-template-columns: 1fr;
		}
	}

	.sim-card, .talents-container, .ai-widget-wrapper {
		background: var(--card-bg);
		border: 2px solid var(--card-border);
		border-radius: 24px;
		padding: 2rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
	}

	/* ALINEACIÓN DE 1 SOLA LÍNEA PARA PASO 1 Y PASO 2 */
	.card-header-block {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.6rem;
		white-space: nowrap;
	}

	.card-step-badge {
		display: inline-flex;
		align-items: center;
