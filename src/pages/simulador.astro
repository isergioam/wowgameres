<!-- LÓGICA INTERACTIVA CLIENT-SIDE -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// --- 1. WEB AUDIO API ---
		let soundEnabled = true;
		let audioCtx = null;

		function initAudio() {
			if (!audioCtx) {
				const AudioContext = window.AudioContext || window.webkitAudioContext;
				if (AudioContext) audioCtx = new AudioContext();
			}
		}

		function playTone(freq = 440, type = 'sine', duration = 0.15) {
			if (!soundEnabled) return;
			try {
				initAudio();
				if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
				if (!audioCtx) return;

				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();
				osc.type = type;
				osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
				gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

				osc.connect(gain);
				gain.connect(audioCtx.destination);
				osc.start();
				osc.stop(audioCtx.currentTime + duration);
			} catch (e) {
				console.warn('Audio API', e);
			}
		}

		const soundBtn = document.getElementById('sound-toggle-btn');
		const soundStatus = document.getElementById('sound-status');
		const soundIcon = document.getElementById('sound-icon');

		soundBtn?.addEventListener('click', () => {
			soundEnabled = !soundEnabled;
			if (soundStatus) soundStatus.textContent = soundEnabled ? 'ACTIVADO' : 'DESACTIVADO';
			if (soundIcon) soundIcon.textContent = soundEnabled ? '🔊' : '🔇';
			if (soundEnabled) playTone(587.33, 'sine', 0.2);
		});

		// --- 2. NAVEGACIÓN ENTRE PESTAÑAS (TABS) ---
		const modeBtns = document.querySelectorAll('.mode-btn');
		const views = document.querySelectorAll('.lab-view');

		function switchTab(targetMode) {
			playTone(523.25, 'triangle', 0.1);
			modeBtns.forEach(b => {
				const isActive = b.getAttribute('data-mode') === targetMode;
				b.classList.toggle('active', isActive);
				b.setAttribute('aria-selected', isActive ? 'true' : 'false');
			});
			views.forEach(v => {
				v.classList.toggle('active-view', v.id === `view-${targetMode}`);
			});
		}

		modeBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const mode = btn.getAttribute('data-mode');
				if (mode) switchTab(mode);
			});
		});

		// --- 3. LÓGICA Y SINCRONIZACIÓN DEL ÁRBOL DE TALENTOS ---
		const talentPoints = {
			multicraft: 12,
			frugality: 8,
			inspiration: 10,
			speed: 0
		};
		let totalPointsUsed = 30;
		const maxPoints = 50;

		function updateTalentsUI() {
			const counter = document.getElementById('points-counter');
			if (counter) counter.textContent = `${totalPointsUsed} / ${maxPoints} Puntos`;

			document.getElementById('val-talent-multicraft').textContent = `${talentPoints.multicraft} Pts`;
			document.getElementById('val-talent-frugality').textContent = `${talentPoints.frugality} Pts`;
			document.getElementById('val-talent-inspiration').textContent = `${talentPoints.inspiration} Pts`;
			document.getElementById('val-talent-speed').textContent = `${talentPoints.speed} Pts`;

			document.getElementById('stat-multicraft').textContent = `+${talentPoints.multicraft}% Multicraft`;
			document.getElementById('stat-frugality').textContent = `-${talentPoints.frugality}% Ahorro de Insumos`;
			document.getElementById('stat-inspiration').textContent = `+${talentPoints.inspiration}% Calidad Máxima`;
			document.getElementById('stat-speed').textContent = `+${talentPoints.speed * 2}% Velocidad`;

			const indicator = document.getElementById('talent-bonus-indicator');
			if (indicator) indicator.textContent = `+${talentPoints.multicraft}% Multicraft (-${talentPoints.frugality}% Mats)`;

			const rangeMulti = document.getElementById('range-multicraft');
			if (rangeMulti) {
				rangeMulti.value = 15 + talentPoints.multicraft;
			}

			calculateProfits();
		}

		document.querySelectorAll('.btn-add').forEach(btn => {
			btn.addEventListener('click', () => {
				const target = btn.getAttribute('data-target');
				if (target && totalPointsUsed < maxPoints) {
					talentPoints[target]++;
					totalPointsUsed++;
					playTone(600 + talentPoints[target] * 20, 'sine', 0.08);
					updateTalentsUI();
				}
			});
		});

		document.querySelectorAll('.btn-sub').forEach(btn => {
			btn.addEventListener('click', () => {
				const target = btn.getAttribute('data-target');
				if (target && talentPoints[target] > 0) {
					talentPoints[target]--;
					totalPointsUsed--;
					playTone(400 - talentPoints[target] * 20, 'sine', 0.08);
					updateTalentsUI();
				}
			});
		});

		document.getElementById('btn-apply-to-sim')?.addEventListener('click', () => {
			switchTab('simulator');
		});

		// --- 4. SIMULADOR DE ORO DINÁMICO ---
		const rangeHours = document.getElementById('range-hours');
		const rangeMulti = document.getElementById('range-multicraft');
		const rangeCost = document.getElementById('range-mat-cost');
		const rangeSell = document.getElementById('range-sell-price');
		const profSelect = document.getElementById('input-prof-type');
		const recipeSelect = document.getElementById('input-recipe-type');

		const valHours = document.getElementById('val-hours');
		const valMulti = document.getElementById('val-multicraft');
		const valCost = document.getElementById('val-mat-cost');
		const valSell = document.getElementById('val-sell-price');

		const totalCounter = document.getElementById('total-gold-counter');
		const hourlyCounter = document.getElementById('hourly-gold-counter');
		const resGross = document.getElementById('res-gross');
		const resCosts = document.getElementById('res-costs');
		const resTax = document.getElementById('res-tax');
		const resRoi = document.getElementById('res-roi');
		const roiBar = document.getElementById('roi-bar');
		const barPercentageLabel = document.getElementById('bar-percentage-label');

		function calculateProfits() {
			if (!rangeHours) return;
			const hours = parseFloat(rangeHours.value);
			const multi = parseFloat(rangeMulti.value) / 100;
			let cost = parseFloat(rangeCost.value);
			const sell = parseFloat(rangeSell.value);

			const matDiscount = (talentPoints.frugality / 100);
			cost = cost * (1 - matDiscount);

			if (valHours) valHours.textContent = `${hours} horas`;
			if (valMulti) valMulti.textContent = `${Math.round(multi * 100)}%`;
			if (valCost) valCost.textContent = `${Math.round(cost)}g`;
			if (valSell) valSell.textContent = `${sell}g`;

			const baseUnitsPerHour = 80;
			const totalHours = hours;
			const totalBaseUnits = baseUnitsPerHour * totalHours;
			const bonusUnits = totalBaseUnits * multi * 1.5;
			const totalProduced = totalBaseUnits + bonusUnits;

			const grossIncome = totalProduced * sell;
			const totalMaterialCost = totalBaseUnits * cost;
			const ahTax = grossIncome * 0.05;
			const netProfit = Math.max(0, grossIncome - totalMaterialCost - ahTax);

			const hourlyProfit = Math.round(netProfit / totalHours);
			const roi = totalMaterialCost > 0 ? Math.round((netProfit / totalMaterialCost) * 100) : 0;
			const marginRatio = grossIncome > 0 ? Math.round((netProfit / grossIncome) * 100) : 0;

			if (totalCounter) totalCounter.textContent = `${Math.round(netProfit).toLocaleString('es-ES')}g`;
			if (hourlyCounter) hourlyCounter.textContent = `~${hourlyProfit.toLocaleString('es-ES')}g por hora activa`;
			if (resGross) resGross.textContent = `${Math.round(grossIncome).toLocaleString('es-ES')}g`;
			if (resCosts) resCosts.textContent = `${Math.round(totalMaterialCost).toLocaleString('es-ES')}g`;
			if (resTax) resTax.textContent = `${Math.round(ahTax).toLocaleString('es-ES')}g`;
			if (resRoi) resRoi.textContent = `+${roi}%`;
			if (roiBar) roiBar.style.width = `${Math.min(marginRatio, 100)}%`;
			if (barPercentageLabel) barPercentageLabel.textContent = `${marginRatio}%`;
		}

		[rangeHours, rangeMulti, rangeCost, rangeSell, profSelect, recipeSelect].forEach(input => {
			input?.addEventListener('input', () => {
				calculateProfits();
				playTone(250 + parseInt(rangeSell?.value || 300), 'sine', 0.02);
			});
		});

		updateTalentsUI();

		// --- 5. CHAT CON FORMATO HTML Y PARSER DE MARKDOWN ---
		const aiForm = document.getElementById('ai-chat-form');
		const aiInput = document.getElementById('ai-user-input');
		const aiChatBox = document.getElementById('ai-chat-box');
		const quickBtns = document.querySelectorAll('.quick-btn');

		function parseSimpleMarkdown(text) {
			return text
				.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
				.replace(/\*(.*?)\*/g, '<em>$1</em>')
				.replace(/\n/g, '<br/>');
		}

		function appendMessage(author, text, isUser = false) {
			if (!aiChatBox) return;
			const msgDiv = document.createElement('div');
			msgDiv.className = `chat-message ${isUser ? 'msg-user' : 'msg-ai'}`;
			const formattedContent = parseSimpleMarkdown(text);
			msgDiv.innerHTML = `
				<div class="msg-author">${author}</div>
				<div class="msg-content">${formattedContent}</div>
			`;
			aiChatBox.appendChild(msgDiv);
			aiChatBox.scrollTop = aiChatBox.scrollHeight;
		}

		function handleAiResponse(query) {
			playTone(600, 'sine', 0.1);
			appendMessage('Tú', query, true);

			setTimeout(() => {
				playTone(800, 'triangle', 0.2);
				let responseText = "Analizando los datos de tu simulador...";

				const qLower = query.toLowerCase();
				if (qLower.includes('receta') || qLower.includes('margen') || qLower.includes('alquimia')) {
					responseText = `Para la receta seleccionada en **Alquimia**, con tu **${talentPoints.multicraft}% de Multicraft** y **${talentPoints.frugality}% de ahorro de materiales**, tu beneficio neto es de **${totalCounter?.textContent || '68.400g'}**.\n\nSi asignas 5 puntos más en *Inspiración Mítica*, elevarás las ventas de Calidad 3 a un precio +45% superior en la Casa de Subastas.`;
				} else if (qLower.includes('puntos') || qLower.includes('distribución') || qLower.includes('talentos')) {
					responseText = `Distribución óptima recomendada para tus **50 Puntos de Conocimiento**:\n\n• **20 Pts** en *Maestría de Multicraft* (máximo multiplicador de procs).\n• **15 Pts** en *Eficiencia de Insumos* (ahorro crítico en plantas raras).\n• **15 Pts** en *Inspiración Mítica* (garantiza calidad máxima).`;
				} else if (qLower.includes('subasta') || qLower.includes('día') || qLower.includes('vender')) {
					responseText = "El momento pico para publicar consumibles en Subasta es el **Martes de 18:00 a 22:00 CET** y el **Miércoles de 17:00 a 20:00 CET**. Durante estos horarios, los grupos de raid compran inventario masivo pagando hasta un 25% más.";
				} else {
					responseText = `Consulta sobre **"${query}"**:\n\nCon los parámetros actuales de tu simulador (ganancia estimada por hora: **${hourlyCounter?.textContent || '~27.000g'}**), tu margen de beneficio es muy sólido. ¡Recuerda vender tus frascos en lotes pequeños de 10 a 20 unidades para acelerar las ventas!`;
				}

				appendMessage('Nexo IA', responseText, false);
			}, 600);
		}

		aiForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			const val = aiInput?.value.trim();
			if (val) {
				handleAiResponse(val);
				if (aiInput) aiInput.value = '';
			}
		});

		quickBtns.forEach(b => {
			b.addEventListener('click', () => {
				const prompt = b.getAttribute('data-prompt');
				if (prompt) handleAiResponse(prompt);
			});
		});

		document.getElementById('btn-consult-ai-sim')?.addEventListener('click', () => {
			switchTab('ai');
			handleAiResponse("¿Cómo puedo optimizar la receta actual de Alquimia para maximizar el margen de oro por hora?");
		});
	});
</script>
