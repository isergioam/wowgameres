---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import AffiliateBanner from "../../../components/AffiliateBanner.astro";
import { WOWHEAD_IDS } from "../../../data/wowheadIds";


interface Step {
  min: number;
  max: number;
  mats: Record<string, number>;
  description: string;
  routeImage?: string;
}

interface GuideData {
  expansionName: string;
  professionName: string;
  maxLevel: number;
  description: string;
  note?: string;
  steps: Step[];
}

interface Props {
  guideData: GuideData;
  professionId: string;
  expansionId: string;
}

const allImages: Record<string, any> = import.meta.glob(
  "/src/assets/images/**/*.{webp,png,jpg,jpeg}",
  { eager: true },
);

export async function getStaticPaths() {
  const allProfessions = await getCollection("professions");
  return allProfessions.flatMap((prof: any) => {
    return Object.keys(prof.data).map((expKey) => {
      return {
        params: { profession: prof.id, expansion: expKey },
        props: {
          guideData: prof.data[expKey],
          professionId: prof.id,
          expansionId: expKey,
        },
      };
    });
  });
}

const { guideData, professionId, expansionId } = Astro.props as Props;
const { expansionName, professionName, maxLevel, description, steps, note } =
  guideData;
const cleanExpansionName = expansionName.replace(/\s*\(.*?\)/g, "").trim();

// Generamos un título de alto impacto SEO
const optimizedTitle = `Guía de ${professionName} ${cleanExpansionName} (1-${maxLevel}) Actualizada | WOWGamerES`;

// Enriquecemos la descripción dinámicamente si es muy corta
const baseDescription =
  description ||
  `Aprende a subir ${professionName} al nivel ${maxLevel} en ${cleanExpansionName}.`;
const seoDescription = `${baseDescription} Rutas paso a paso, lista de materiales y trucos para ahorrar oro en WoW ${cleanExpansionName}.`;

const isPngProfession = [
  "mineria",
  "herboristeria",
  "desuello",
  "pesca",
  "arqueologia",
  "cocina",
  "primeros-auxilios",
].includes(professionId);
const imgNameSeo = professionId.replace(/-/g, "_");
const seoImage = `/images/${imgNameSeo}_wow.webp`;

// Datos Estructurados para Fragmentos Destacados en Google
const schemaJSON = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `Guía de ${professionName} ${cleanExpansionName}`,
  description: seoDescription,
  step: steps.map((s: Step, i: number) => ({
    "@type": "HowToStep",
    name: `Nivel ${s.min}-${s.max}`,
    url: `https://wowgameres.com/guias/${professionId}/${expansionId}#niveles`,
    text: s.description.replace(/<[^>]*>?/gm, "").trim(),
  })),
};
---

<BaseLayout
  title={optimizedTitle}
  description={seoDescription}
  image={seoImage}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schemaJSON)}
  />

  {
    (() => {
      const imgName = professionId.replace(/-/g, "_");
      const mainImgPath = `/src/assets/images/${imgName}_wow.webp`;
      const heroImageAsset = allImages[mainImgPath];
      return (
        <header class="guide-hero-detail">
          <div class="hero-bg">
            {heroImageAsset && (
              <Image
                src={heroImageAsset.default}
                alt={professionName}
                width={1920}
                height={1080}
                format="avif"
                quality="mid"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
            <div class="hero-overlay" />
          </div>
          <div class="hero-container content">
            <div class="hero-content">
              <nav class="guide-breadcrumb">
                <a href="/">Inicio</a>
                <span class="sep">/</span>
                <a href={`/guias/${expansionId}`}>{expansionName}</a>
                <span class="sep">/</span>
                <span class="current">{professionName}</span>
              </nav>

              <h1 id="guide-h1" class="hero-title-stack">
                <span class="hero-main-title">{professionName}</span>
                <span class="hero-separator"></span>
                <span class="hero-exp-name">{cleanExpansionName}</span>
              </h1>
              <p class="hero-intro">{description}</p>
            </div>
          </div>
        </header>
      );
    })()
  }

  <main class="content">
    <!-- Bloque Informativo -->
    <div class="intro-description-box section reveal" style="margin-top: 30px;">
      <p style="margin-bottom: 12px;">
        {
          [
            "mineria",
            "herboristeria",
            "desuello",
            "pesca",
            "arqueologia",
          ].includes(professionId)
            ? `Dominar ${professionName} en ${cleanExpansionName} es clave para cualquier habitante de Azeroth. Esta guía te muestra las mejores rutas y zonas para subir de nivel rápidamente.`
            : `Dominar ${professionName} en ${cleanExpansionName} requiere recolectar y crear objetos de manera eficiente. Esta guía está diseñada para llevarte al nivel máximo (${maxLevel}) ahorrando el máximo oro posible.`
        }
      </p>
      <p>
        <span style="color: var(--primary-color, #bb9fff); font-weight: 500;"
          >💡 Consejo de uso:</span
        >
        {
          [
            "mineria",
            "herboristeria",
            "desuello",
            "pesca",
            "arqueologia",
          ].includes(professionId)
            ? "Consulta las zonas y rutas recomendadas a continuación y haz clic en los pasos para marcar tu avance."
            : "Utiliza el rastreador para marcar los materiales que ya posees y filtrar los pasos según tu nivel actual."
        }
      </p>
    </div>

    <!-- Controles Nivelación -->
    <div
      id="leveling-controls"
      class="leveling-wrapper-glass section"
      style={[
        "mineria",
        "herboristeria",
        "desuello",
        "pesca",
        "arqueologia",
      ].includes(professionId)
        ? "display: none;"
        : ""}
    >
      <div class="glass-header">
        <h2 class="glass-title">Filtro por Nivel de Profesión</h2>
        <div class="glass-badge">
          Nivel <span id="currentLevelDisplay">1</span>
        </div>
        <button
          id="resetProgress"
          class="reset-btn-mini"
          title="Borrar todo el progreso de esta guía"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
            ></path><path d="M3 3v5h5"></path></svg
          >
          <span>Reiniciar</span>
        </button>
      </div>
      <div class="glass-slider-container">
        <input
          type="range"
          id="levelSlider"
          aria-label="Filtro de nivel"
          min="1"
          max={maxLevel}
          value="1"
          class="glass-slider"
        />
      </div>
    </div>

    <!-- Materiales -->
    <section
      id="materiales"
      class="section reveal"
      style={steps.every((s: Step) => Object.keys(s.mats).length === 0)
        ? "display: none;"
        : ""}
    >
      <div id="materialsToggle" class="section-toggle">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="minimal-icon"
            ><path
              d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
            ></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"
            ></path></svg
          >
          <h2 class="section-toggle-title">Materiales necesarios</h2>
        </div>
        <div style="display: flex; gap: 15px; align-items: center;">
          <button id="copyMaterials" class="copy-btn-premium">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-clipboard"
              ><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path
                d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
              ></path></svg
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-check"
              style="display: none;"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            <span>Copiar Lista</span>
          </button>
          <span id="materialsToggleIcon" class="section-toggle-icon">▼</span>
        </div>
      </div>
      <div id="materialsContent" class="section-content">
        <!-- Barra de Progreso de Recolección Dinámica -->
        <div class="farming-progress-container" style="margin-bottom: 25px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); padding: 16px; border-radius: 12px; backdrop-filter: blur(5px);">
          <div class="farming-progress-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span style="font-size: 0.9rem; font-weight: 600; color: var(--text-color); letter-spacing: 0.3px;">Progreso de Recolección</span>
            <span id="farmingProgressPercentage" style="font-size: 0.95rem; font-weight: 800; color: var(--primary-purple); text-shadow: 0 0 10px rgba(187, 159, 255, 0.2);">0%</span>
          </div>
          <div class="farming-progress-track" style="width: 100%; height: 8px; background: rgba(0, 0, 0, 0.15); border-radius: 10px; overflow: hidden; position: relative;">
            <div id="farmingProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #bb9fff 0%, #a855f7 100%); border-radius: 10px; transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 10px rgba(187, 159, 255, 0.3);"></div>
          </div>
        </div>

        <p class="interaction-hint">
          * Haz clic para marcar los materiales que ya tengas. Haz clic en el nombre del material para buscarlo en Wowhead.
        </p>
        <table
          id="materialsTable"
          style="width: 100%; text-align: left; border-collapse: collapse; margin-top: 10px;"
        >
          <thead>
            <tr class="materials-header-row">
              <th
                id="sortByName"
                style="padding: 5px; cursor: pointer; user-select: none;"
              >
                Material <span id="sortIndicatorName" class="sort-indicator"
                  >▼</span
                ></th
              >
              <th
                id="sortByQty"
                style="padding: 5px; cursor: pointer; user-select: none;"
                >Cantidad
                <span id="sortIndicatorQty" class="sort-indicator">↕</span>
              </th>
            </tr>
          </thead>
          <tbody id="materialsBody">
            <!-- Dinámico vía Script -->
          </tbody>
        </table>
        {
          note && (
            <p
              id="guide-note"
              style="margin-top: 10px; font-size: 0.9em; opacity: 0.8;"
            >
              {note}
            </p>
          )
        }
      </div>



    </section>

    <AffiliateBanner />

    <!-- Nivelación (Pasos) -->
    <section id="niveles" class="section reveal">
      <div id="recipesToggle" class="section-toggle">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="minimal-icon"
            ><path
              d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path><path d="M14 2v6h6"></path><path d="M8 13h8"></path><path
              d="M8 17h8"></path><path d="M10 9H8"></path></svg
          >
          <h2 class="section-toggle-title">
            {
              [
                "mineria",
                "herboristeria",
                "desuello",
                "pesca",
                "arqueologia",
              ].includes(professionId)
                ? "Rutas de recolección"
                : "Recetas por nivel"
            }
          </h2>
        </div>
        <span id="recipesToggleIcon" class="section-toggle-icon">▼</span>
      </div>

      <div id="recipesContent" class="section-content">
        <p class="interaction-hint">
          * Haz clic para marcar los pasos que ya hiciste.
        </p>
        {
          steps.map((step: Step, index: number) => (
            <div
              class="custom-step"
              data-min={step.min}
              data-max={step.max}
              data-mats={JSON.stringify(step.mats)}
            >
              <div class="step-info">
                <Fragment set:html={step.description} />
              </div>
              {step.routeImage && (
                <div
                  class="route-map-container reveal"
                  style="margin-top: 15px;"
                >
                  {(() => {
                    const assetPath = `/src/assets${step.routeImage}`.replace(/\.png$/, '.webp');
                    const imgAsset = allImages[assetPath];
                    
                    // Extraemos el título del paso para el overlay
                    let mapTitle = "Ruta de Recolección";
                    const regex = new RegExp('<div class="step-title">([^<]+)</div>');
                    const titleMatch = step.description.match(regex);
                    if (titleMatch && titleMatch[1]) {
                      // Limpiamos el texto (e.g. "Minería 1 - 65: Cobre" -> "Cobre")
                      const parts = titleMatch[1].split(':');
                      mapTitle = parts.length > 1 ? parts[1].trim() : titleMatch[1];
                    }

                    if (imgAsset) {
                      return (
                        <div style="position: relative; display: inline-block; max-width: 100%;">
                          <Image
                            src={imgAsset.default}
                            alt={`Ruta de farmueo WoW ${step.min}-${step.max}`}
                            class="route-map-img"
                            width={800}
                            height={450}
                            format="avif"
                            quality="mid"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="route-map-overlay">
                            <span class="overlay-title">📍 Zona Recomendada</span>
                            <span class="overlay-subtitle">{mapTitle}</span>
                          </div>
                        </div>
                      );
                    } else {
                      return (
                        <p style="color: red; font-size: 0.8rem;">
                          [Error: Imagen no encontrada en {assetPath}]
                        </p>
                      );
                    }
                  })()}
                  <p class="route-caption">Haz clic en la imagen para ver más de cerca</p>
                </div>
              )}
            </div>
          ))
        }
      </div>
      <!-- Botones de Compartir -->
      <ShareButtons />



    </section>
  </main>

  <!-- Modal para Zoom de Imágenes con Controles -->
  <div id="imageModal" class="image-modal">
    <div class="modal-header">
      <span class="close-modal">&times;</span>
      <div class="modal-controls">
        <button id="zoomInBtn" class="control-btn" title="Acercar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <button id="zoomOutBtn" class="control-btn" title="Alejar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <button id="zoomResetBtn" class="control-btn" title="Restablecer">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
        <span id="zoomIndicator" class="zoom-indicator">100%</span>
      </div>
    </div>
    <div class="modal-viewport">
      <div id="modalImageWrapper" class="modal-image-wrapper">
        <img class="modal-content" id="imgModalDisplay" draggable="false" />
      </div>
    </div>
    <div class="modal-instructions">
      <span>🖱️ Rueda del ratón para Zoom | 🖐️ Arrastra para mover | 📱 Gestos táctiles en móvil</span>
    </div>
  </div>
</BaseLayout>

<!-- Inyectamos el diccionario de IDs de Wowhead como variable global (is:inline preserva TS en el script principal) -->
<script is:inline set:html={`window.__WOWHEAD_IDS__ = ${JSON.stringify(WOWHEAD_IDS)};`}></script>

<script>
  // Elementos DOM
  const slider = document.getElementById("levelSlider") as HTMLInputElement;
  const display = document.getElementById("currentLevelDisplay");
  const materialsBody = document.getElementById("materialsBody");
  const sortByNameBtn = document.getElementById("sortByName");
  const sortByQtyBtn = document.getElementById("sortByQty");
  const sortIndName = document.getElementById("sortIndicatorName");
  const sortIndQty = document.getElementById("sortIndicatorQty");

  let currentSort = "name";
  let nameAsc = true;
  let qtyAsc = false;

  // --- PERSISTENCIA ---
  const pathParts = window.location.pathname.split("/").filter(Boolean);
  const profession = pathParts[pathParts.length - 2];
  const expansion = pathParts[pathParts.length - 1];
  const storageKey = `wow_progress_${profession}_${expansion}`;

  let checkedMaterials = new Set<string>();
  let completedSteps = new Set<number>();

  function saveProgress() {
    const data = {
      level: slider?.value,
      materials: Array.from(checkedMaterials),
      steps: Array.from(completedSteps),
    };
    localStorage.setItem(storageKey, JSON.stringify(data));
  }

  function loadProgress() {
    const saved = localStorage.getItem(storageKey);
    if (saved) {
      try {
        const data = JSON.parse(saved);
        if (slider) slider.value = data.level;
        checkedMaterials = new Set(data.materials || []);
        completedSteps = new Set(data.steps || []);

        const steps = document.querySelectorAll(".custom-step");
        completedSteps.forEach((index) => {
          if (steps[index]) {
            steps[index].classList.add("step-completed");
          }
        });

        updateLeveling();
      } catch (e) {
        console.error("Error loading progress", e);
      }
    }
  }

  function updateLeveling() {
    if (!slider || !materialsBody) return;
    const steps = document.querySelectorAll(
      ".custom-step",
    ) as NodeListOf<HTMLElement>;
    const currentLevel = parseInt(slider.value);
    if (display) display.textContent = currentLevel.toString();

    const totalMats: Record<string, number> = {};

    steps.forEach((step) => {
      const max = parseInt(step.getAttribute("data-max") || "0");
      if (currentLevel >= max) {
        step.style.display = "none";
      } else {
        step.style.display = "block";
        const matsStr = step.getAttribute("data-mats");
        if (matsStr) {
          try {
            const mats = JSON.parse(matsStr);
            for (const [mat, qty] of Object.entries(mats)) {
              totalMats[mat] =
                ((totalMats[mat] as number) || 0) + (qty as number);
            }
          } catch (e) {
            console.error("Error parsing materials JSON", e);
          }
        }
      }
    });

    materialsBody.innerHTML = "";
    const matsEntries = Object.entries(totalMats);

    if (matsEntries.length === 0) {
      materialsBody.innerHTML =
        '<tr><td colspan="2" style="text-align:center; padding: 10px;">¡Ya has alcanzado el nivel máximo de esta guía!</td></tr>';
      return;
    }

    let matsArray = matsEntries.map(([name, qty]) => ({ name, qty }));

    matsArray.sort((a, b) => {
      if (currentSort === "name") {
        const res = a.name.localeCompare(b.name);
        return nameAsc ? res : -res;
      } else {
        const res = a.qty - b.qty;
        return qtyAsc ? res : -res;
      }
    });

    if (sortIndName)
      sortIndName.textContent =
        currentSort === "name" ? (nameAsc ? "▼" : "▲") : "↕";
    if (sortIndQty)
      sortIndQty.textContent =
        currentSort === "qty" ? (qtyAsc ? "▼" : "▲") : "↕";

    matsArray.forEach((item) => {
      const tr = document.createElement("tr");
      tr.style.borderBottom = "1px solid #e0d4ff";

      // Aplicar estado de persistencia
      if (checkedMaterials.has(item.name)) {
        tr.style.opacity = "0.3";
        tr.style.textDecoration = "line-through";
      }

      // Generar link de Wowhead: con ID real si está en el diccionario, con búsqueda si no
      const wowIds = (window as any).__WOWHEAD_IDS__ as Record<string, number> || {};
      const itemId = wowIds[item.name];
      const wowheadHref = itemId
        ? `https://es.wowhead.com/item=${itemId}`
        : `https://es.wowhead.com/search?q=${encodeURIComponent(item.name)}`;

      tr.innerHTML = `
        <td style="padding: 5px;">
          <a href="${wowheadHref}" 
             target="_blank" 
             rel="noopener noreferrer" 
             class="wowhead-tooltip-link" 
             style="color: var(--text-color); text-decoration: none; transition: color 0.2s;"
             onclick="event.stopPropagation();"
          >
            ${item.name}
          </a>
        </td>
        <td style="padding: 5px; font-weight: 700; color: var(--primary-purple);">${item.qty}</td>
      `;
      materialsBody.appendChild(tr);
    });

    // Actualizar Barra de Progreso
    const totalItems = matsArray.length;
    let checkedCount = 0;
    matsArray.forEach(item => {
      if (checkedMaterials.has(item.name)) checkedCount++;
    });
    const percentage = totalItems > 0 ? Math.round((checkedCount / totalItems) * 100) : 0;
    const progressPercentage = document.getElementById("farmingProgressPercentage");
    const progressBar = document.getElementById("farmingProgressBar");
    if (progressPercentage && progressBar) {
      progressPercentage.textContent = `${percentage}%`;
      progressBar.style.width = `${percentage}%`;
    }
  }

  // Event Listeners
  slider?.addEventListener("input", () => {
    updateLeveling();
    saveProgress();
  });

  sortByNameBtn?.addEventListener("click", () => {
    if (currentSort === "name") nameAsc = !nameAsc;
    else {
      currentSort = "name";
      nameAsc = true;
    }
    updateLeveling();
  });

  sortByQtyBtn?.addEventListener("click", () => {
    if (currentSort === "qty") qtyAsc = !qtyAsc;
    else {
      currentSort = "qty";
      qtyAsc = false;
    }
    updateLeveling();
  });

  // Checklist y Completado
  materialsBody?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const tr = target.closest("tr");
    if (tr) {
      const matName = tr.querySelector("td")?.textContent?.trim();
      if (matName) {
        if (checkedMaterials.has(matName)) {
          checkedMaterials.delete(matName);
          tr.style.opacity = "1";
          tr.style.textDecoration = "none";
        } else {
          checkedMaterials.add(matName);
          tr.style.opacity = "0.3";
          tr.style.textDecoration = "line-through";
        }
        saveProgress();
        
        // Recalcular Barra de Progreso al hacer click
        const rows = materialsBody.querySelectorAll("tr");
        let checked = 0;
        let total = 0;
        rows.forEach(r => {
          const name = r.querySelector("td")?.textContent?.trim();
          if (name) {
            total++;
            if (checkedMaterials.has(name)) checked++;
          }
        });
        const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
        const progressPercentage = document.getElementById("farmingProgressPercentage");
        const progressBar = document.getElementById("farmingProgressBar");
        if (progressPercentage && progressBar) {
          progressPercentage.textContent = `${pct}%`;
          progressBar.style.width = `${pct}%`;
        }
      }
    }
  });

  // --- LÓGICA DE MODAL CON ZOOM Y PAN ---
  const modal = document.getElementById("imageModal");
  const modalImg = document.getElementById("imgModalDisplay") as HTMLImageElement;
  const imgWrapper = document.getElementById("modalImageWrapper");
  const zoomInBtn = document.getElementById("zoomInBtn");
  const zoomOutBtn = document.getElementById("zoomOutBtn");
  const zoomResetBtn = document.getElementById("zoomResetBtn");
  const zoomIndicator = document.getElementById("zoomIndicator");
  const closeModal = document.querySelector(".close-modal");

  let scale = 1;
  let pointX = 0;
  let pointY = 0;
  let startX = 0;
  let startY = 0;
  let isDragging = false;

  function updateTransform() {
    if (modalImg) {
      modalImg.style.transform = `scale(${scale}) translate(${pointX / scale}px, ${pointY / scale}px)`;
      if (zoomIndicator) {
        zoomIndicator.textContent = `${Math.round(scale * 100)}%`;
      }
    }
  }

  function resetZoom() {
    scale = 1;
    pointX = 0;
    pointY = 0;
    updateTransform();
  }

  if (zoomInBtn && zoomOutBtn && zoomResetBtn) {
    zoomInBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      scale = Math.min(scale + 0.25, 4);
      updateTransform();
    });

    zoomOutBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      scale = Math.max(scale - 0.25, 0.5);
      updateTransform();
    });

    zoomResetBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      resetZoom();
    });
  }

  imgWrapper?.addEventListener("wheel", (e) => {
    e.preventDefault();
    const delta = e.deltaY < 0 ? 1 : -1;
    const newScale = delta > 0
      ? Math.min(scale + 0.15, 4)
      : Math.max(scale - 0.15, 0.5);
    scale = newScale;
    updateTransform();
  }, { passive: false });

  imgWrapper?.addEventListener("mousedown", (e) => {
    e.preventDefault();
    isDragging = true;
    startX = e.clientX - pointX;
    startY = e.clientY - pointY;
    if (imgWrapper) imgWrapper.style.cursor = "grabbing";
  });

  window.addEventListener("mousemove", (e) => {
    if (!isDragging) return;
    pointX = e.clientX - startX;
    pointY = e.clientY - startY;
    updateTransform();
  });

  window.addEventListener("mouseup", () => {
    isDragging = false;
    if (imgWrapper) (imgWrapper as HTMLElement).style.cursor = scale > 1 ? "grab" : "default";
  });

  let touchStartX = 0;
  let touchStartY = 0;
  imgWrapper?.addEventListener("touchstart", (e) => {
    if (e.touches.length === 1) {
      isDragging = true;
      touchStartX = e.touches[0].clientX - pointX;
      touchStartY = e.touches[0].clientY - pointY;
    }
  });

  imgWrapper?.addEventListener("touchmove", (e) => {
    if (!isDragging || e.touches.length !== 1) return;
    pointX = e.touches[0].clientX - touchStartX;
    pointY = e.touches[0].clientY - touchStartY;
    updateTransform();
  });

  imgWrapper?.addEventListener("touchend", () => {
    isDragging = false;
  });

  const recipesContent = document.getElementById("recipesContent");
  recipesContent?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    
    if (target.classList.contains("route-map-img")) {
      e.stopPropagation();
      if (modal && modalImg) {
        modal.style.display = "flex";
        modalImg.src = (target as HTMLImageElement).src;
        resetZoom();
      }
      return;
    }

    const step = target.closest(".custom-step") as HTMLElement;
    if (step) {
      const allSteps = Array.from(document.querySelectorAll(".custom-step"));
      const stepIndex = allSteps.indexOf(step);

      step.classList.toggle("step-completed");
      if (step.classList.contains("step-completed")) {
        completedSteps.add(stepIndex);
      } else {
        completedSteps.delete(stepIndex);
      }
      saveProgress();
    }
  });

  if (modal && closeModal) {
    closeModal.addEventListener("click", (e) => {
      e.stopPropagation();
      modal.style.display = "none";
    });
    modal.addEventListener("click", (e) => {
      if (e.target === modal || e.target === document.querySelector(".modal-viewport")) {
        modal.style.display = "none";
      }
    });
  }

  // Copiar al portapapeles
  document.getElementById("copyMaterials")?.addEventListener("click", (e) => {
    e.stopPropagation();
    const rows = materialsBody?.querySelectorAll("tr");
    if (!rows) return;

    let text = `Lista de materiales - ${document.title}\n\n`;
    rows.forEach((row) => {
      const cells = row.querySelectorAll("td");
      if (cells.length >= 2) {
        text += `- ${cells[1].textContent}x ${cells[0].textContent}\n`;
      }
    });

    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById("copyMaterials");
      const iconClipboard = btn?.querySelector(
        ".icon-clipboard",
      ) as HTMLElement;
      const iconCheck = btn?.querySelector(".icon-check") as HTMLElement;
      const textSpan = btn?.querySelector("span");

      if (iconClipboard && iconCheck && textSpan) {
        iconClipboard.style.display = "none";
        iconCheck.style.display = "block";
        textSpan.textContent = "¡Copiado!";

        setTimeout(() => {
          iconClipboard.style.display = "block";
          iconCheck.style.display = "none";
          textSpan.textContent = "Copiar Lista";
        }, 2000);
      }
    });
  });

  // Toggles
  document.getElementById("materialsToggle")?.addEventListener("click", () => {
    const content = document.getElementById("materialsContent");
    const icon = document.getElementById("materialsToggleIcon");
    if (content && icon) {
      const isHidden = content.style.display === "none";
      content.style.display = isHidden ? "block" : "none";
      icon.style.transform = isHidden ? "rotate(0deg)" : "rotate(-90deg)";
    }
  });
  document.getElementById("recipesToggle")?.addEventListener("click", () => {
    const content = document.getElementById("recipesContent");
    const icon = document.getElementById("recipesToggleIcon");
    if (content && icon) {
      const isHidden = content.style.display === "none";
      content.style.display = isHidden ? "block" : "none";
      icon.style.transform = isHidden ? "rotate(0deg)" : "rotate(-90deg)";
    }
  });

  loadProgress();
  if (
    checkedMaterials.size === 0 &&
    completedSteps.size === 0 &&
    slider &&
    slider.value === "1"
  ) {
    updateLeveling();
  }

  // --- REINICIAR PROGRESO ---
  document.getElementById("resetProgress")?.addEventListener("click", () => {
    if (
      confirm(
        "¿Estás seguro de que quieres borrar todo el progreso guardado en esta guía?",
      )
    ) {
      localStorage.removeItem(storageKey);

      // Resetear estado local
      if (slider) slider.value = "1";
      checkedMaterials.clear();
      completedSteps.clear();

      // Resetear UI de pasos
      document.querySelectorAll(".custom-step").forEach((step) => {
        step.classList.remove("step-completed");
      });

      updateLeveling();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>
