---
// WowForeverBanner.astro
---

<div class="wow-forever-banner" id="wow-forever-banner">
    <div class="banner-bg"></div>
    <div class="banner-inner">
        
        <!-- Izquierda: Logo y Texto -->
        <div class="banner-left">
            <!-- Icono/Logo simulado (puedes reemplazar el SVG por un <img src="/images/tu-logo.png" /> cuando tengas el oficial extraído) -->
            <div class="logo-wrapper">
                <svg viewBox="0 0 100 100" class="wow-logo" xmlns="http://www.w3.org/2000/svg">
                    <!-- Engranaje / Fondo -->
                    <polygon points="50,2 62,12 76,10 83,22 96,25 96,39 106,50 96,61 96,75 83,78 76,90 62,88 50,98 38,88 24,90 17,78 4,75 4,61 -6,50 4,39 4,25 17,22 24,10 38,12" fill="#d4b47d" transform="scale(0.85) translate(8, 8)"/>
                    <circle cx="50" cy="50" r="38" fill="#143142" />
                    <circle cx="50" cy="50" r="34" fill="#1b455c" stroke="#d4b47d" stroke-width="2"/>
                    <!-- Letra W -->
                    <path d="M 28 35 L 40 70 L 50 50 L 60 70 L 72 35 L 60 35 L 54 52 L 50 40 L 46 52 L 40 35 Z" fill="#fdf1d6" />
                    <!-- Símbolo Infinito (Forever) atravesando -->
                    <path d="M 15 50 C 15 35, 40 35, 50 50 C 60 65, 85 65, 85 50 C 85 35, 60 35, 50 50 C 40 65, 15 65, 15 50 Z" fill="none" stroke="#66d9ff" stroke-width="4" opacity="0.8"/>
                </svg>
            </div>
            
            <span class="banner-title">¡La nueva sección dedicada a WoW Forever llega el 4/11!</span>
        </div>

        <!-- Derecha: Contador -->
        <div class="banner-right">
            <div class="countdown" id="wow-countdown">
                <div class="time-block">
                    <span class="number" id="cd-days">40</span>
                    <span class="label">DÍAS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-hours">00</span>
                    <span class="label">HORAS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-minutes">00</span>
                    <span class="label">MINUTOS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-seconds">00</span>
                    <span class="label">SEGUNDOS</span>
                </div>
            </div>
        </div>
        
    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&display=swap');

    .wow-forever-banner {
        width: 100%;
        height: 80px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 3000;
        background: radial-gradient(ellipse at center, #10627e 0%, #063850 100%);
        border-top: 6px solid #b2935d;
        border-bottom: 6px solid #b2935d;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        color: #fdf1d6;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .banner-bg {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: 
            radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
            radial-gradient(circle at 80% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);
        opacity: 0.7;
        pointer-events: none;
    }

    .banner-inner {
        width: 100%;
        max-width: 1200px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1rem;
        position: relative;
        z-index: 1;
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .logo-wrapper {
        width: 50px;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wow-logo {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }

    .banner-title {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 1.3rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-shadow: 0 2px 4px rgba(0,0,0,0.6);
    }

    .banner-right {
        display: flex;
        align-items: center;
    }

    .countdown {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
    }

    .time-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 45px;
    }

    .number {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 2.2rem;
        font-weight: 500;
        line-height: 1;
        text-shadow: 0 2px 6px rgba(0,0,0,0.7);
    }

    .label {
        font-family: 'Inter', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        margin-top: 0.2rem;
        letter-spacing: 0.05em;
        color: #fdf1d6;
        opacity: 0.9;
    }

    .separator {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 1.8rem;
        font-weight: 500;
        opacity: 0.7;
        margin: 0 0.2rem;
        transform: translateY(-8px);
    }

    /* Reglas globales para empujar el header y otros banners flotantes hacia abajo cuando este banner está activo */
    :global(html.has-wow-banner .main-header) {
        top: 95px !important;
    }
    :global(html.has-wow-banner .main-header.scrolled) {
        top: 88px !important;
    }
    :global(html.has-wow-banner .nexo-tool-banner) {
        top: 182px !important;
    }
    :global(html.has-wow-banner .nexo-tool-banner.scrolled) {
        top: 164px !important;
    }

    @media (max-width: 900px) {
        .banner-inner {
            flex-direction: column;
            justify-content: center;
            gap: 0.5rem;
        }
        .banner-title {
            font-size: 1.1rem;
        }
        .number {
            font-size: 1.6rem;
        }
        .separator {
            font-size: 1.2rem;
            transform: translateY(-5px);
        }
        .logo-wrapper {
            width: 35px;
            height: 35px;
        }
        .wow-forever-banner {
            height: 100px;
        }
        :global(html.has-wow-banner .main-header) { top: 115px !important; }
        :global(html.has-wow-banner .main-header.scrolled) { top: 108px !important; }
        :global(html.has-wow-banner .nexo-tool-banner) { top: 202px !important; }
        :global(html.has-wow-banner .nexo-tool-banner.scrolled) { top: 184px !important; }
    }
    
    @media (max-width: 500px) {
        .banner-left {
            gap: 0.5rem;
        }
        .banner-title {
            font-size: 0.9rem;
        }
    }
</style>

<script is:inline>
    // Se ejecuta inmediatamente para evitar el parpadeo visual del menú superpuesto
    document.documentElement.classList.add('has-wow-banner');
</script>

<script>
    // --- LÓGICA DEL CONTADOR ---
    // Fecha objetivo exacta extraída directamente de la web oficial de Blizzard
    const targetDate = new Date('2026-11-04T23:00:00Z').getTime();

    const elDays = document.getElementById('cd-days');
    const elHours = document.getElementById('cd-hours');
    const elMins = document.getElementById('cd-minutes');
    const elSecs = document.getElementById('cd-seconds');

    function updateCountdown() {
        if (!elDays || !elHours || !elMins || !elSecs) return;

        const now = new Date().getTime();
        const distance = targetDate - now;

        if (distance < 0) {
            // El tiempo ha expirado
            elDays.innerText = "00";
            elHours.innerText = "00";
            elMins.innerText = "00";
            elSecs.innerText = "00";
            return;
        }

        // Cálculos matemáticos para días, horas, minutos y segundos
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        // Formatear a 2 dígitos
        elDays.innerText = days.toString().padStart(2, '0');
        elHours.innerText = hours.toString().padStart(2, '0');
        elMins.innerText = minutes.toString().padStart(2, '0');
        elSecs.innerText = seconds.toString().padStart(2, '0');
    }

    // Actualizar el contador cada segundo
    setInterval(updateCountdown, 1000);
    // Ejecutar inmediatamente una vez para no ver los ceros iniciales
    updateCountdown();
</script>
