---
// WowForeverBanner.astro
---

<div class="wow-forever-banner" id="wow-forever-banner">
    <div class="banner-bg"></div>
    <div class="banner-inner">
        
        <!-- Izquierda: Logo y Texto -->
        <div class="banner-left">
            <!-- Icono/Logo simulado (puedes reemplazar el SVG por un <img src="/images/tu-logo.png" /> cuando tengas el oficial extraído) -->
            <div class="logo-wrapper">
                <svg viewBox="0 0 100 100" class="wow-logo" xmlns="http://www.w3.org/2000/svg">
                    <!-- Engranaje / Fondo -->
                    <polygon points="50,2 62,12 76,10 83,22 96,25 96,39 106,50 96,61 96,75 83,78 76,90 62,88 50,98 38,88 24,90 17,78 4,75 4,61 -6,50 4,39 4,25 17,22 24,10 38,12" fill="#d4b47d" transform="scale(0.85) translate(8, 8)"/>
                    <circle cx="50" cy="50" r="38" fill="#143142" />
                    <circle cx="50" cy="50" r="34" fill="#1b455c" stroke="#d4b47d" stroke-width="2"/>
                    <!-- Letra W -->
                    <path d="M 28 35 L 40 70 L 50 50 L 60 70 L 72 35 L 60 35 L 54 52 L 50 40 L 46 52 L 40 35 Z" fill="#fdf1d6" />
                    <!-- Símbolo Infinito (Forever) atravesando -->
                    <path d="M 15 50 C 15 35, 40 35, 50 50 C 60 65, 85 65, 85 50 C 85 35, 60 35, 50 50 C 40 65, 15 65, 15 50 Z" fill="none" stroke="#66d9ff" stroke-width="4" opacity="0.8"/>
                </svg>
            </div>
            
            <span class="banner-title">¡La nueva sección dedicada a WoW Forever llega el 4/11!</span>
        </div>

        <!-- Derecha: Contador -->
        <div class="banner-right">
            <div class="countdown" id="wow-countdown">
                <div class="time-block">
                    <span class="number" id="cd-days">40</span>
                    <span class="label">DÍAS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-hours">00</span>
                    <span class="label">HORAS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-minutes">00</span>
                    <span class="label">MINUTOS</span>
                </div>
                <span class="separator">:</span>
                <div class="time-block">
                    <span class="number" id="cd-seconds">00</span>
                    <span class="label">SEGUNDOS</span>
                </div>
            </div>
        </div>
        
    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&display=swap');

    .wow-forever-banner {
        width: 100%;
        height: 80px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 3000;
        background: radial-gradient(ellipse at center, #10627e 0%, #063850 100%);
        border-top: 6px solid #b2935d;
        border-bottom: 6px solid #b2935d;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        color: #fdf1d6;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .banner-bg {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: 
            radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
            radial-gradient(circle at 80% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);
        opacity: 0.7;
        pointer-events: none;
    }

    .banner-inner {
        width: 100%;
        max-width: 1200px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1rem;
        position: relative;
        z-index: 1;
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .logo-wrapper {
        width: 50px;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .wow-logo {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }

    .banner-title {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: 0.02em;
        text-shadow: 0 2px 4px rgba(0,0,0,0.6);
    }

    .banner-right {
        display: flex;
        align-items: center;
    }

    .countdown {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
    }

    .time-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 45px;
    }

    .number {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 2.2rem;
        font-weight: 500;
        line-height: 1;
        text-shadow: 0 2px 6px rgba(0,0,0,0.7);
    }

    .label {
        font-family: 'Inter', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        line-height: 1.1;
        margin-top: 0.2rem;
        letter-spacing: 0.05em;
        color: #fdf1d6;
        opacity: 0.9;
    }

    .separator {
        font-family: 'Cinzel', Georgia, serif;
        font-size: 1.8rem;
        font-weight: 500;
        opacity: 0.7;
        margin: 0 0.2rem;
        transform: translateY(-8px);
    }

    /* Reglas globales para empujar el header, el contenido y los banners flotantes cuando este banner está activo (Solo en Retail) */
    :global(html:not([data-version="forever"]).has-wow-banner) {
        --header-height-desktop: 215px;
        --header-height-tablet: 225px;
        --header-height-mobile: 232px;
        --sticky-top-offset: 196px;
    }
    :global(html:not([data-version="forever"]).has-wow-banner .main-header) {
        top: 92px !important;
    }
    :global(html:not([data-version="forever"]).has-wow-banner .main-header.scrolled) {
        top: 86px !important;
    }
    :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner) {
        top: 180px !important;
    }
    :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner.scrolled) {
        top: 162px !important;
    }

    @media (max-width: 900px) {
        .banner-inner {
            flex-direction: column;
            justify-content: center;
            gap: 0.25rem;
            padding: 0 0.75rem;
        }
        .banner-left {
            justify-content: center;
            gap: 0.6rem;
        }
        .banner-title {
            font-size: 0.98rem;
            line-height: 1.2;
            text-align: center;
        }
        .number {
            font-size: 1.45rem;
        }
        .separator {
            font-size: 1.15rem;
            transform: translateY(-4px);
        }
        .logo-wrapper {
            width: 30px;
            height: 30px;
            flex-shrink: 0;
        }
        .wow-forever-banner {
            height: 90px;
            border-top-width: 4px;
            border-bottom-width: 4px;
        }
        :global(html:not([data-version="forever"]).has-wow-banner .main-header) { top: 98px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .main-header.scrolled) { top: 92px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner) { top: 186px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner.scrolled) { top: 168px !important; }
    }

    @media (max-width: 768px) {
        .wow-forever-banner {
            height: 86px;
            padding: 2px 6px;
        }
        .banner-inner {
            gap: 3px;
            padding: 0 6px;
        }
        .banner-left {
            gap: 6px;
        }
        .logo-wrapper {
            width: 26px;
            height: 26px;
        }
        .banner-title {
            font-size: 0.8rem;
            line-height: 1.18;
        }
        .countdown {
            gap: 0.45rem;
        }
        .time-block {
            min-width: 36px;
        }
        .number {
            font-size: 1.3rem;
        }
        .label {
            font-size: 0.52rem;
            margin-top: 2px;
        }
        .separator {
            font-size: 1.05rem;
            transform: translateY(-4px);
            margin: 0 0.1rem;
        }
        .banner-launch-btn {
            font-size: 0.78rem;
            padding: 0.3rem 0.85rem;
        }
        :global(html:not([data-version="forever"]).has-wow-banner) {
            --sticky-top-offset: 186px;
        }
        :global(html:not([data-version="forever"]).has-wow-banner .main-header) { top: 92px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .main-header.scrolled) { top: 88px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner) { top: 198px !important; }
        :global(html:not([data-version="forever"]).has-wow-banner .nexo-tool-banner.scrolled) {
            top: 185px !important;
            opacity: 0 !important;
            pointer-events: none !important;
        }
    }

    @media (max-width: 400px) {
        .banner-title {
            font-size: 0.74rem;
        }
        .number {
            font-size: 1.2rem;
        }
    }

    .banner-launch-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #d4b47d, #f59e0b);
        color: #0d2836;
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.45rem 1.1rem;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(212, 180, 125, 0.45);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
        letter-spacing: 0.05em;
        white-space: nowrap;
        animation: pulseGlow 2.5s infinite;
    }

    .banner-launch-btn:hover {
        transform: translateY(-1px) scale(1.04);
        box-shadow: 0 6px 20px rgba(212, 180, 125, 0.65);
        background: linear-gradient(135deg, #fdf1d6, #d4b47d);
    }

    @keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 4px 14px rgba(212, 180, 125, 0.45);
        }
        50% {
            box-shadow: 0 4px 22px rgba(245, 158, 11, 0.7);
        }
    }
</style>

<script is:inline>
    // Solo añadir si no estamos en Forever
    if (document.documentElement.getAttribute('data-version') !== 'forever') {
        document.documentElement.classList.add('has-wow-banner');
    }
</script>

<script>
    // --- LÓGICA DEL CONTADOR Y LANZAMIENTO AUTOMÁTICO ---
    // Fecha objetivo exacta extraída directamente de la web oficial de Blizzard
    const targetDate = new Date('2026-11-04T23:00:00Z').getTime();

    const elDays = document.getElementById('cd-days');
    const elHours = document.getElementById('cd-hours');
    const elMins = document.getElementById('cd-minutes');
    const elSecs = document.getElementById('cd-seconds');

    function updateCountdown() {
        const now = new Date().getTime();
        const distance = targetDate - now;

        if (distance <= 0) {
            // El tiempo ha expirado: Lanzamiento oficial de WoW Forever
            window.dispatchEvent(new CustomEvent('wow-forever-launch'));

            const bannerTitle = document.querySelector('.banner-title');
            if (bannerTitle && !bannerTitle.getAttribute('data-launched')) {
                bannerTitle.setAttribute('data-launched', 'true');
                bannerTitle.textContent = "¡WoW Forever ya está disponible! Descubre las nuevas guías.";
            }

            const bannerCountdown = document.getElementById('wow-countdown');
            if (bannerCountdown && !bannerCountdown.getAttribute('data-launched')) {
                bannerCountdown.setAttribute('data-launched', 'true');
                bannerCountdown.innerHTML = `
                    <a href="/guias/forever/" class="banner-launch-btn">
                        <span>¡EXPLORAR GUÍAS!</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                `;
            }

            if (elDays && elHours && elMins && elSecs) {
                elDays.innerText = "00";
                elHours.innerText = "00";
                elMins.innerText = "00";
                elSecs.innerText = "00";
            }
            return;
        }

        if (!elDays || !elHours || !elMins || !elSecs) return;

        // Cálculos matemáticos para días, horas, minutos y segundos
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        // Formatear a 2 dígitos
        elDays.innerText = days.toString().padStart(2, '0');
        elHours.innerText = hours.toString().padStart(2, '0');
        elMins.innerText = minutes.toString().padStart(2, '0');
        elSecs.innerText = seconds.toString().padStart(2, '0');
    }

    // Actualizar el contador cada segundo
    setInterval(updateCountdown, 1000);
    // Ejecutar inmediatamente una vez para no ver los ceros iniciales
    updateCountdown();
</script>
