---
/**
 * AffiliateBanner.astro
 * Hub de afiliados premium integrado (Eneba, Instant Gaming, Amazon).
 * Rediseño estilo Glassmorphism con gráficos vectoriales puros sin fondos ni cuadrículas.
 */
import { Image } from 'astro:assets';
import enebaLogoImg from '../assets/images/afiliados/eneba-logo.png';
import igLogoImg from '../assets/images/afiliados/instant-gaming-logo.svg';
import amazonLogoImg from '../assets/images/afiliados/amazon-logo.png';

// ENLACES DE AFILIADOS (Directos a contenido de WoW)
const ENEBA_URL = "https://www.eneba.com/store/all?text=world+of+warcraft&af_id=wowgameres";
const INSTANT_GAMING_URL = "https://www.instant-gaming.com/es/busquedas/?query=world+of+warcraft&igr=wowgameres";
const AMAZON_URL = "https://www.amazon.es/s?k=funko+pop+world+of+warcraft&tag=wowgameres-21";
---

<div class="affiliate-hub-container">
  <div class="hub-header">
    <div class="hub-badge">🛒 Apoya la Web</div>
    <h3 class="hub-title">Consigue tu Tiempo de Juego y Gaming Gear al mejor precio</h3>
    <p class="hub-subtitle">
      Comprando a través de estos enlaces nos ayudas a mantener las guías 100% actualizadas y libres de anuncios molestos. ¡Gracias por tu apoyo!
    </p>
  </div>

  <div class="hub-grid">
    <!-- ENEBA -->
    <a href={ENEBA_URL} target="_blank" rel="noopener noreferrer" class="hub-card eneba-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={enebaLogoImg} alt="Eneba" class="eneba-png-logo" />
            <span class="eneba-text-hub">eneba</span>
         </div>
      </div>

      <div class="pill-badge-box pill-purple">
        Suscripciones y<br />Saldo Battle.net
      </div>

      <!-- Gráfico vectorial transparente de Tarjetas Battle.net -->
      <div class="card-preview-container">
        <div class="bnet-visual-wrapper">
          <div class="bnet-card bnet-blue">
            <div class="bnet-chip"></div>
            <div class="bnet-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <span class="bnet-amount">€20</span>
            <span class="bnet-brand">BATTLE.NET</span>
          </div>
          <div class="bnet-card bnet-gold">
            <div class="bnet-chip"></div>
            <div class="bnet-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <span class="bnet-amount">€50</span>
            <span class="bnet-brand">BATTLE.NET</span>
          </div>
        </div>
      </div>

      <div class="btn-solid btn-eneba">
        Ver Ofertas en Eneba
      </div>
    </a>

    <!-- INSTANT GAMING -->
    <a href={INSTANT_GAMING_URL} target="_blank" rel="noopener noreferrer" class="hub-card ig-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={igLogoImg} alt="Instant Gaming" class="ig-svg-logo" />
         </div>
      </div>

      <div class="pill-badge-box pill-blue">
        60 Días de Tiempo<br />de Juego WoW
      </div>

      <!-- Gráfico vectorial transparente de Tarjeta Tiempo de Juego WoW -->
      <div class="card-preview-container">
        <div class="wow-card-visual">
          <div class="wow-card-header">
            <span class="blizz-tag">BLIZZARD</span>
            <span class="region-tag">EU / GLOBAL</span>
          </div>
          <div class="wow-card-body">
            <div class="wow-title-emblem">WORLD OF WARCRAFT</div>
            <div class="wow-card-sub">PREPAID GAME TIME</div>
          </div>
          <div class="wow-card-footer">
            <span class="days-badge">60 DAYS</span>
            <span class="code-icon">⚡ CÓDIGO DIGITAL</span>
          </div>
        </div>
      </div>

      <div class="btn-solid btn-ig">
        Comprar Tiempo de Juego
      </div>
    </a>

    <!-- AMAZON -->
    <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer" class="hub-card amazon-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={amazonLogoImg} alt="Amazon" class="amazon-png-logo" />
         </div>
      </div>

      <div class="pill-badge-box pill-gold">
        Funkos Pop y<br />Merch de WoW
      </div>

      <!-- Gráfico vectorial transparente de Funko Box + Taza Horda -->
      <div class="card-preview-container">
        <div class="merch-visual-wrapper">
          <div class="funko-box-visual">
            <div class="funko-top">POP! GAMES</div>
            <div class="funko-title">WARCRAFT</div>
            <div class="funko-figure-silhouette">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a5 5 0 00-5 5v3H5a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2h-2V7a5 5 0 00-5-5zm-3 5a3 3 0 016 0v3H9V7z"/></svg>
            </div>
            <div class="funko-num">#30</div>
          </div>
          <div class="horde-mug-visual">
            <div class="mug-handle"></div>
            <div class="horde-symbol">⚔️</div>
          </div>
        </div>
      </div>

      <div class="btn-solid btn-amazon">
        Explorar Merch en Amazon
      </div>
    </a>
  </div>
</div>

<style>
  .affiliate-hub-container {
    max-width: 1150px;
    margin: 50px auto;
    padding: 35px 30px;
    background: rgba(18, 14, 33, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    backdrop-filter: blur(16px);
    position: relative;
    z-index: 5;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  html:not(.dark-mode) .affiliate-hub-container {
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(106, 13, 173, 0.22);
    box-shadow: 0 15px 35px rgba(106, 13, 173, 0.05);
  }

  .hub-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 35px;
  }

  .hub-badge {
    display: inline-block;
    background: rgba(187, 159, 255, 0.1);
    border: 1px solid rgba(187, 159, 255, 0.25);
    color: #bb9fff;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
  }

  html:not(.dark-mode) .hub-badge {
    background: rgba(106, 13, 173, 0.06);
    border-color: rgba(106, 13, 173, 0.15);
    color: var(--primary-purple);
  }

  .hub-title {
    font-size: 1.7rem;
    font-weight: 900;
    color: white;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
    border: none;
    padding: 0;
  }

  html:not(.dark-mode) .hub-title {
    color: var(--text-dark);
  }

  .hub-subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  html:not(.dark-mode) .hub-subtitle {
    color: rgba(0, 0, 0, 0.65);
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Glassmorphism Cards */
  .hub-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 24px;
    padding: 24px 20px;
    text-decoration: none;
    color: white;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    overflow: hidden;
    position: relative;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15);
  }

  html:not(.dark-mode) .hub-card {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Eneba Card Style */
  .eneba-card {
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(255, 255, 255, 0.05);
  }
  .eneba-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 15px 40px rgba(175, 82, 222, 0.3), 0 0 30px rgba(255, 255, 255, 0.25);
  }

  /* Instant Gaming Card Style */
  .ig-card {
    border: 1.5px solid rgba(0, 162, 255, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(0, 162, 255, 0.15);
  }
  .ig-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 195, 255, 0.85);
    box-shadow: 0 15px 40px rgba(0, 150, 255, 0.4), 0 0 30px rgba(0, 162, 255, 0.3);
  }

  /* Amazon Card Style */
  .amazon-card {
    border: 1.5px solid rgba(255, 174, 0, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(255, 174, 0, 0.15);
  }
  .amazon-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 190, 40, 0.85);
    box-shadow: 0 15px 40px rgba(255, 160, 0, 0.4), 0 0 30px rgba(255, 174, 0, 0.3);
  }

  /* Header Logos */
  .card-header {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .eneba-png-logo { max-height: 32px; width: auto; object-fit: contain; }
  .eneba-text-hub {
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
    letter-spacing: -1.2px;
    font-family: 'Outfit', 'Inter', sans-serif;
  }
  html:not(.dark-mode) .eneba-text-hub { color: #222; }

  .ig-svg-logo { max-height: 44px; width: auto; object-fit: contain; }
  .amazon-png-logo { max-height: 38px; width: auto; object-fit: contain; }

  /* Pill Badges in upper center */
  .pill-badge-box {
    width: 100%;
    text-align: center;
    padding: 12px 14px;
    border-radius: 18px;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.35;
    margin-bottom: 20px;
    backdrop-filter: blur(6px);
  }

  .pill-purple {
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.15);
  }

  html:not(.dark-mode) .pill-purple {
    background: rgba(175, 82, 222, 0.08);
    border-color: rgba(175, 82, 222, 0.4);
    color: #6d1b9e;
  }

  .pill-blue {
    background: rgba(0, 162, 255, 0.08);
    border: 1.5px solid rgba(0, 195, 255, 0.7);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(0, 162, 255, 0.25);
  }

  html:not(.dark-mode) .pill-blue {
    background: rgba(0, 140, 255, 0.08);
    border-color: rgba(0, 140, 255, 0.4);
    color: #005bb5;
  }

  .pill-gold {
    background: rgba(255, 174, 0, 0.08);
    border: 1.5px solid rgba(255, 190, 40, 0.7);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(255, 174, 0, 0.25);
  }

  html:not(.dark-mode) .pill-gold {
    background: rgba(255, 160, 0, 0.08);
    border-color: rgba(255, 160, 0, 0.4);
    color: #995c00;
  }

  /* Product Preview Graphics Container */
  .card-preview-container {
    width: 100%;
    height: 185px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    background: transparent;
    position: relative;
  }

  /* CARD 1 VISUAL: Battle.net Cards */
  .bnet-visual-wrapper {
    position: relative;
    width: 170px;
    height: 140px;
  }

  .bnet-card {
    position: absolute;
    width: 105px;
    height: 135px;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s ease;
  }

  .bnet-blue {
    background: linear-gradient(145deg, #0055b3, #002255);
    border: 1.5px solid rgba(0, 150, 255, 0.5);
    top: 5px;
    left: 10px;
    transform: rotate(-10deg);
  }

  .bnet-gold {
    background: linear-gradient(145deg, #cfa030, #664800);
    border: 1.5px solid rgba(255, 215, 0, 0.6);
    top: 0px;
    right: 10px;
    transform: rotate(8deg);
  }

  .hub-card:hover .bnet-blue {
    transform: rotate(-15deg) translateY(-4px);
  }
  .hub-card:hover .bnet-gold {
    transform: rotate(13deg) translateY(-4px);
  }

  .bnet-chip {
    width: 22px;
    height: 16px;
    background: linear-gradient(135deg, #ffe082, #ffb300);
    border-radius: 4px;
  }

  .bnet-icon svg {
    width: 32px;
    height: 32px;
    color: rgba(255, 255, 255, 0.9);
  }

  .bnet-amount {
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
    letter-spacing: -0.5px;
  }

  .bnet-brand {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.7);
  }

  /* CARD 2 VISUAL: WoW Game Time Card */
  .wow-card-visual {
    width: 200px;
    height: 125px;
    background: linear-gradient(135deg, #2b1f0d, #140d04);
    border: 2px solid #d4af37;
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.2);
    transition: transform 0.35s ease;
  }

  .hub-card:hover .wow-card-visual {
    transform: scale(1.06) translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.7), 0 0 28px rgba(212, 175, 55, 0.4);
  }

  .wow-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blizz-tag {
    font-size: 0.65rem;
    font-weight: 900;
    color: #00a2ff;
    letter-spacing: 1.5px;
  }

  .region-tag {
    font-size: 0.6rem;
    font-weight: 800;
    color: #d4af37;
    background: rgba(212, 175, 55, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .wow-card-body {
    text-align: center;
    margin: 4px 0;
  }

  .wow-title-emblem {
    font-size: 0.95rem;
    font-weight: 900;
    color: #f7d353;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    font-family: 'Outfit', 'Inter', sans-serif;
  }

  .wow-card-sub {
    font-size: 0.65rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 1px;
  }

  .wow-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .days-badge {
    background: linear-gradient(135deg, #0099ff, #0055ff);
    color: white;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .code-icon {
    font-size: 0.62rem;
    font-weight: 700;
    color: #00ffaa;
  }

  /* CARD 3 VISUAL: Funko Box + Horde Mug */
  .merch-visual-wrapper {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 12px;
    height: 140px;
  }

  .funko-box-visual {
    width: 90px;
    height: 130px;
    background: linear-gradient(145deg, #1e261c, #0a1209);
    border: 2px solid #52b74c;
    border-radius: 10px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s ease;
  }

  .hub-card:hover .funko-box-visual {
    transform: rotate(-4deg) translateY(-4px);
  }

  .funko-top {
    font-size: 0.55rem;
    font-weight: 900;
    color: #52b74c;
    letter-spacing: 0.5px;
  }

  .funko-title {
    font-size: 0.7rem;
    font-weight: 900;
    color: white;
  }

  .funko-figure-silhouette svg {
    width: 42px;
    height: 42px;
    color: #52b74c;
    margin: 0 auto;
    display: block;
  }

  .funko-num {
    font-size: 0.75rem;
    font-weight: 900;
    color: #52b74c;
    text-align: right;
  }

  .horde-mug-visual {
    width: 65px;
    height: 75px;
    background: linear-gradient(135deg, #b31212, #5e0505);
    border: 1.5px solid #ff4d4d;
    border-radius: 8px 14px 8px 8px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s ease;
  }

  .hub-card:hover .horde-mug-visual {
    transform: rotate(6deg) translateY(-4px);
  }

  .mug-handle {
    position: absolute;
    right: -12px;
    top: 15px;
    width: 14px;
    height: 40px;
    border: 3px solid #b31212;
    border-left: none;
    border-radius: 0 10px 10px 0;
  }

  .horde-symbol {
    font-size: 1.6rem;
  }

  /* Solid Vibrant CTA Buttons */
  .btn-solid {
    width: 100%;
    padding: 15px 18px;
    border-radius: 18px;
    font-size: 0.98rem;
    font-weight: 800;
    text-align: center;
    letter-spacing: -0.2px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .btn-eneba {
    background: linear-gradient(135deg, #ff5500, #ff2200);
    color: #ffffff;
  }
  .hub-card:hover .btn-eneba {
    background: linear-gradient(135deg, #ff6611, #ff3311);
    box-shadow: 0 12px 25px rgba(255, 69, 0, 0.45);
  }

  .btn-ig {
    background: linear-gradient(135deg, #0099ff, #0066ff);
    color: #ffffff;
  }
  .hub-card:hover .btn-ig {
    background: linear-gradient(135deg, #1ab0ff, #1a75ff);
    box-shadow: 0 12px 25px rgba(0, 140, 255, 0.45);
  }

  .btn-amazon {
    background: linear-gradient(135deg, #ffb700, #ffa000);
    color: #160e00;
  }
  .hub-card:hover .btn-amazon {
    background: linear-gradient(135deg, #ffc426, #ffad1a);
    box-shadow: 0 12px 25px rgba(255, 170, 0, 0.45);
  }

  @media (max-width: 900px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
