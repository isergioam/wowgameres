---
/**
 * AffiliateBanner.astro
 * Hub de afiliados premium integrado (Eneba, Instant Gaming, Amazon).
 * Rediseño estilo Glassmorphism con imágenes de producto transparentes de alta resolución.
 */
import { Image } from 'astro:assets';
import enebaLogoImg from '../assets/images/afiliados/eneba-logo.png';
import igLogoImg from '../assets/images/afiliados/instant-gaming-logo.svg';
import amazonLogoImg from '../assets/images/afiliados/amazon-logo.png';

import enebaPreviewImg from '../assets/images/afiliados/eneba-preview.png';
import igPreviewImg from '../assets/images/afiliados/ig-preview.png';
import amazonPreviewImg from '../assets/images/afiliados/amazon-preview.png';

// ENLACES DE AFILIADOS (Directos a contenido de WoW)
const ENEBA_URL = "https://www.eneba.com/store/all?text=world+of+warcraft&af_id=wowgameres";
const INSTANT_GAMING_URL = "https://www.instant-gaming.com/es/busquedas/?query=world+of+warcraft&igr=wowgameres";
const AMAZON_URL = "https://www.amazon.es/s?k=funko+pop+world+of+warcraft&tag=wowgameres-21";
---

<div class="affiliate-hub-container">
  <div class="hub-header">
    <div class="hub-badge">🛒 Apoya la Web</div>
    <h3 class="hub-title">Consigue tu Tiempo de Juego y Gaming Gear al mejor precio</h3>
    <p class="hub-subtitle">
      Comprando a través de estos enlaces nos ayudas a mantener las guías 100% actualizadas y libres de anuncios molestos. ¡Gracias por tu apoyo!
    </p>
  </div>

  <div class="hub-grid">
    <!-- ENEBA -->
    <a href={ENEBA_URL} target="_blank" rel="noopener noreferrer" class="hub-card eneba-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={enebaLogoImg} alt="Eneba" class="eneba-png-logo" />
            <span class="eneba-text-hub">eneba</span>
         </div>
      </div>

      <div class="pill-badge-box pill-purple">
        Suscripciones y<br />Saldo Battle.net
      </div>

      <div class="card-preview-container">
        <Image src={enebaPreviewImg} alt="Saldo Battle.net Eneba" class="card-preview-img" />
      </div>

      <div class="btn-solid btn-eneba">
        Ver Ofertas en Eneba
      </div>
    </a>

    <!-- INSTANT GAMING -->
    <a href={INSTANT_GAMING_URL} target="_blank" rel="noopener noreferrer" class="hub-card ig-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={igLogoImg} alt="Instant Gaming" class="ig-svg-logo" />
         </div>
      </div>

      <div class="pill-badge-box pill-blue">
        60 Días de Tiempo<br />de Juego WoW
      </div>

      <div class="card-preview-container">
        <Image src={igPreviewImg} alt="Tarjeta Tiempo de Juego Instant Gaming" class="card-preview-img" />
      </div>

      <div class="btn-solid btn-ig">
        Comprar Tiempo de Juego
      </div>
    </a>

    <!-- AMAZON -->
    <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer" class="hub-card amazon-card">
      <div class="card-header">
         <div class="logo-wrapper">
            <Image src={amazonLogoImg} alt="Amazon" class="amazon-png-logo" />
         </div>
      </div>

      <div class="pill-badge-box pill-gold">
        Funkos Pop y<br />Merch de WoW
      </div>

      <div class="card-preview-container">
        <Image src={amazonPreviewImg} alt="Funkos y Merch Amazon" class="card-preview-img" />
      </div>

      <div class="btn-solid btn-amazon">
        Explorar Merch en Amazon
      </div>
    </a>
  </div>
</div>

<style>
  .affiliate-hub-container {
    max-width: 1150px;
    margin: 50px auto;
    padding: 35px 30px;
    background: rgba(18, 14, 33, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    backdrop-filter: blur(16px);
    position: relative;
    z-index: 5;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  html:not(.dark-mode) .affiliate-hub-container {
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(106, 13, 173, 0.22);
    box-shadow: 0 15px 35px rgba(106, 13, 173, 0.05);
  }

  .hub-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 35px;
  }

  .hub-badge {
    display: inline-block;
    background: rgba(187, 159, 255, 0.1);
    border: 1px solid rgba(187, 159, 255, 0.25);
    color: #bb9fff;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
  }

  html:not(.dark-mode) .hub-badge {
    background: rgba(106, 13, 173, 0.06);
    border-color: rgba(106, 13, 173, 0.15);
    color: var(--primary-purple);
  }

  .hub-title {
    font-size: 1.7rem;
    font-weight: 900;
    color: white;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
    border: none;
    padding: 0;
  }

  html:not(.dark-mode) .hub-title {
    color: var(--text-dark);
  }

  .hub-subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  html:not(.dark-mode) .hub-subtitle {
    color: rgba(0, 0, 0, 0.65);
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Glassmorphism Cards */
  .hub-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 24px;
    padding: 24px 20px;
    text-decoration: none;
    color: white;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    overflow: hidden;
    position: relative;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15);
  }

  html:not(.dark-mode) .hub-card {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Eneba Card Style */
  .eneba-card {
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(255, 255, 255, 0.05);
  }
  .eneba-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 15px 40px rgba(175, 82, 222, 0.3), 0 0 30px rgba(255, 255, 255, 0.25);
  }

  /* Instant Gaming Card Style */
  .ig-card {
    border: 1.5px solid rgba(0, 162, 255, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(0, 162, 255, 0.15);
  }
  .ig-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 195, 255, 0.85);
    box-shadow: 0 15px 40px rgba(0, 150, 255, 0.4), 0 0 30px rgba(0, 162, 255, 0.3);
  }

  /* Amazon Card Style */
  .amazon-card {
    border: 1.5px solid rgba(255, 174, 0, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(255, 174, 0, 0.15);
  }
  .amazon-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 190, 40, 0.85);
    box-shadow: 0 15px 40px rgba(255, 160, 0, 0.4), 0 0 30px rgba(255, 174, 0, 0.3);
  }

  /* Header Logos */
  .card-header {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .eneba-png-logo { max-height: 32px; width: auto; object-fit: contain; }
  .eneba-text-hub {
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
    letter-spacing: -1.2px;
    font-family: 'Outfit', 'Inter', sans-serif;
  }
  html:not(.dark-mode) .eneba-text-hub { color: #222; }

  .ig-svg-logo { max-height: 44px; width: auto; object-fit: contain; }
  .amazon-png-logo { max-height: 38px; width: auto; object-fit: contain; }

  /* Pill Badges in upper center */
  .pill-badge-box {
    width: 100%;
    text-align: center;
    padding: 12px 14px;
    border-radius: 18px;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.35;
    margin-bottom: 20px;
    backdrop-filter: blur(6px);
  }

  .pill-purple {
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.15);
  }

  html:not(.dark-mode) .pill-purple {
    background: rgba(175, 82, 222, 0.08);
    border-color: rgba(175, 82, 222, 0.4);
    color: #6d1b9e;
  }

  .pill-blue {
    background: rgba(0, 162, 255, 0.08);
    border: 1.5px solid rgba(0, 195, 255, 0.7);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(0, 162, 255, 0.25);
  }

  html:not(.dark-mode) .pill-blue {
    background: rgba(0, 140, 255, 0.08);
    border-color: rgba(0, 140, 255, 0.4);
    color: #005bb5;
  }

  .pill-gold {
    background: rgba(255, 174, 0, 0.08);
    border: 1.5px solid rgba(255, 190, 40, 0.7);
    color: #ffffff;
    box-shadow: 0 0 18px rgba(255, 174, 0, 0.25);
  }

  html:not(.dark-mode) .pill-gold {
    background: rgba(255, 160, 0, 0.08);
    border-color: rgba(255, 160, 0, 0.4);
    color: #995c00;
  }

  /* Product Preview Graphics */
  .card-preview-container {
    width: 100%;
    height: 185px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    background: transparent;
    position: relative;
  }

  .card-preview-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.6));
    transition: transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .hub-card:hover .card-preview-img {
    transform: scale(1.08) translateY(-4px);
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.75));
  }

  /* Solid Vibrant CTA Buttons */
  .btn-solid {
    width: 100%;
    padding: 15px 18px;
    border-radius: 18px;
    font-size: 0.98rem;
    font-weight: 800;
    text-align: center;
    letter-spacing: -0.2px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .btn-eneba {
    background: linear-gradient(135deg, #ff5500, #ff2200);
    color: #ffffff;
  }
  .hub-card:hover .btn-eneba {
    background: linear-gradient(135deg, #ff6611, #ff3311);
    box-shadow: 0 12px 25px rgba(255, 69, 0, 0.45);
  }

  .btn-ig {
    background: linear-gradient(135deg, #0099ff, #0066ff);
    color: #ffffff;
  }
  .hub-card:hover .btn-ig {
    background: linear-gradient(135deg, #1ab0ff, #1a75ff);
    box-shadow: 0 12px 25px rgba(0, 140, 255, 0.45);
  }

  .btn-amazon {
    background: linear-gradient(135deg, #ffb700, #ffa000);
    color: #160e00;
  }
  .hub-card:hover .btn-amazon {
    background: linear-gradient(135deg, #ffc426, #ffad1a);
    box-shadow: 0 12px 25px rgba(255, 170, 0, 0.45);
  }

  @media (max-width: 900px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
