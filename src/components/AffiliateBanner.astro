---
/**
 * AffiliateBanner.astro
 * Hub de afiliados premium integrado (Eneba, Instant Gaming, Amazon).
 */

// ENLACES DE AFILIADOS (Modificables)
const ENEBA_URL = "https://www.eneba.com/?af_id=wowgameres";
const INSTANT_GAMING_URL = "https://www.instant-gaming.com/?igr=wowgameres";
const AMAZON_URL = "https://www.amazon.es/?tag=wowgameres-21";
---

<div class="affiliate-hub-container">
  <div class="hub-header">
    <div class="hub-badge">🛒 Apoya la Web</div>
    <h3 class="hub-title">Consigue tu Tiempo de Juego y Gaming Gear al mejor precio</h3>
    <p class="hub-subtitle">
      Comprando a través de estos enlaces nos ayudas a mantener las guías 100% actualizadas y libres de anuncios molestos. ¡Gracias por tu apoyo!
    </p>
  </div>

  <div class="hub-grid">
    <!-- ENEBA -->
    <a href={ENEBA_URL} target="_blank" rel="noopener noreferrer" class="hub-card eneba-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
           <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-svg eneba-svg">
             <path d="M 50,15 A 35,35 0 1 1 25.3,25.3 C 27.5,23 30,21 32.7,19.4" stroke="url(#enebaGradientHub)" stroke-width="13" stroke-linecap="round"/>
             <path d="M 32.7,19.4 A 35,35 0 0 1 50,15" stroke="url(#enebaTealHub)" stroke-width="13" stroke-linecap="round"/>
             <defs>
               <linearGradient id="enebaGradientHub" x1="15" y1="15" x2="85" y2="85" gradientUnits="userSpaceOnUse">
                 <stop offset="0%" stop-color="#ff3e00"/>
                 <stop offset="25%" stop-color="#ff007a"/>
                 <stop offset="50%" stop-color="#9a00e6"/>
                 <stop offset="75%" stop-color="#2a00ff"/>
                 <stop offset="100%" stop-color="#00e1ff"/>
               </linearGradient>
               <linearGradient id="enebaTealHub" x1="32.7" y1="19.4" x2="50" y2="15" gradientUnits="userSpaceOnUse">
                 <stop offset="0%" stop-color="#00ff8c"/>
                 <stop offset="100%" stop-color="#ffd100"/>
               </linearGradient>
             </defs>
           </svg>
           <span class="eneba-text-hub">eneba</span>
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-purple">Suscripciones y Saldo</span>
        <p class="card-desc">Tarjetas de saldo Battle.net, prepagos de WoW y claves de expansión con descuentos instantáneos.</p>
        <div class="hub-cta">
          Ver ofertas en Eneba
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>

    <!-- INSTANT GAMING -->
    <a href={INSTANT_GAMING_URL} target="_blank" rel="noopener noreferrer" class="hub-card ig-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
           <div class="ig-logo-badge">IG</div>
           <span class="ig-text-hub">Instant Gaming</span>
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-orange">Tiempo de Juego Oficial</span>
        <p class="card-desc">Compra tiempo de juego de 30 o 60 días al instante, de forma 100% segura y sin esperas.</p>
        <div class="hub-cta">
          Ver en Instant Gaming
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>

    <!-- AMAZON -->
    <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer" class="hub-card amazon-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
            <svg viewBox="0 0 100 35" fill="none" xmlns="http://www.w3.org/2000/svg" class="amazon-svg">
              <path d="M12.5 17.2c0-1.8 1.4-2.8 3.5-2.8 1.8 0 2.8.6 2.8 1.8v2.7c-1 .8-2.6 1.1-4 1.1-1.8 0-2.3-.8-2.3-2.8zm6.3-5.2c-.8-.5-1.8-.7-2.7-.7-3.5 0-5.8 2.2-5.8 5.8 0 3.5 2.1 5.4 5.2 5.4 1.8 0 3-.6 3.7-1.4v1.1h2.2v-10.2h-2.6v.7z" fill="white"/>
              <path d="M22 10h2.5v2.2c.8-1.5 2.2-2.5 3.8-2.5 1.8 0 2.8.9 3.2 2.2.8-1.5 2.2-2.2 3.8-2.2 2.8 0 4.2 1.8 4.2 4.6v8.2h-2.6v-7.6c0-1.8-.7-2.7-2.1-2.7-1.4 0-2.2 1-2.2 2.7v7.6h-2.6v-7.6c0-1.8-.7-2.7-2.1-2.7-1.4 0-2.2 1-2.2 2.7v7.6H22V10z" fill="white"/>
              <path d="M49.5 17.2c0-1.8 1.4-2.8 3.5-2.8 1.8 0 2.8.6 2.8 1.8v2.7c-1 .8-2.6 1.1-4 1.1-1.8 0-2.3-.8-2.3-2.8zm6.3-5.2c-.8-.5-1.8-.7-2.7-.7-3.5 0-5.8 2.2-5.8 5.8 0 3.5 2.1 5.4 5.2 5.4 1.8 0 3-.6 3.7-1.4v1.1h2.2v-10.2h-2.6v.7z" fill="white"/>
              <path d="M60.2 21.2l6.2-8.6h-5.8V10h9.3v2.2l-6.2 8.6h6.2v2.6h-9.7v-2.2z" fill="white"/>
              <path d="M82.2 16.2c0-3.5-2.2-6.5-5.8-6.5S70.6 12.7 70.6 16.2s2.2 6.5 5.8 6.5 5.8-3 5.8-6.5zm-8.8 0c0-2.5 1.3-4.1 3-4.1s3 1.6 3 4.1-1.3 4.1-3 4.1-3-1.6-3-4.1z" fill="white"/>
              <path d="M84.5 10h2.5v1.8c.8-1.4 2.2-2.1 3.8-2.1 2.8 0 4.2 1.8 4.2 4.6v8.2h-2.6v-7.6c0-1.8-.7-2.7-2.1-2.7-1.4 0-2.2 1-2.2 2.7v7.6h-2.6V10z" fill="white"/>
              <!-- Curved Smile Arrow -->
              <path d="M14 26c15 8 36 8 47-1" stroke="#ff9900" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M61 25l-2-6 5 3-3 3z" fill="#ff9900"/>
            </svg>
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-yellow">Merch y Periféricos</span>
        <p class="card-desc">Libros del Lore oficial de Warcraft, novelas, figuras coleccionables y hardware para tu PC.</p>
        <div class="hub-cta">
          Ver en Amazon
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>
  </div>
</div>

<style>
  .affiliate-hub-container {
    max-width: 1100px;
    margin: 50px auto;
    padding: 30px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 5;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  }

  .hub-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 35px;
  }

  .hub-badge {
    display: inline-block;
    background: rgba(187, 159, 255, 0.1);
    border: 1px solid rgba(187, 159, 255, 0.2);
    color: #bb9fff;
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
  }

  .hub-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
    border: none;
    padding: 0;
  }

  .hub-subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    text-decoration: none;
    color: white;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    overflow: hidden;
    position: relative;
  }

  /* Eneba Brand Color Theme */
  .eneba-card:hover {
    transform: translateY(-5px);
    border-color: rgba(175, 82, 222, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(175, 82, 222, 0.04));
    box-shadow: 0 10px 25px rgba(175, 82, 222, 0.15);
  }

  .eneba-card:hover .hub-cta {
    color: #c586ff;
  }

  /* Instant Gaming Brand Color Theme */
  .ig-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 100, 0, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(255, 100, 0, 0.04));
    box-shadow: 0 10px 25px rgba(255, 100, 0, 0.15);
  }

  .ig-card:hover .hub-cta {
    color: #ff8533;
  }

  /* Amazon Brand Color Theme */
  .amazon-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 153, 0, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(255, 153, 0, 0.04));
    box-shadow: 0 10px 25px rgba(255, 153, 0, 0.15);
  }

  .amazon-card:hover .hub-cta {
    color: #ffb84d;
  }

  .card-brand-visual {
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(0, 0, 0, 0.15);
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.3s ease;
  }

  .hub-card:hover .logo-wrapper {
    transform: scale(1.05);
  }

  /* Logos styling */
  .eneba-svg {
    width: 42px;
    height: 42px;
    filter: drop-shadow(0 0 8px rgba(154, 0, 230, 0.2));
  }

  .eneba-text-hub {
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    letter-spacing: -1.3px;
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
  }

  .ig-logo-badge {
    background: #ff6400;
    color: white;
    font-size: 1.1rem;
    font-weight: 900;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(255, 100, 0, 0.3);
  }

  .ig-text-hub {
    font-size: 1.2rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.3px;
  }

  .amazon-svg {
    width: 95px;
    height: auto;
  }

  .card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    width: fit-content;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .tag-purple {
    background: rgba(175, 82, 222, 0.15);
    color: #d39eff;
  }

  .tag-orange {
    background: rgba(255, 100, 0, 0.15);
    color: #ff944d;
  }

  .tag-yellow {
    background: rgba(255, 153, 0, 0.15);
    color: #ffc266;
  }

  .card-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
    flex: 1;
  }

  .hub-cta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .hub-cta svg {
    transition: transform 0.3s ease;
  }

  .hub-card:hover .hub-cta svg {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .affiliate-hub-container {
      padding: 20px;
    }
    .card-brand-visual {
      height: 90px;
    }
  }
</style>
