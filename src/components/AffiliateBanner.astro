---
/**
 * AffiliateBanner.astro
 * Hub de afiliados premium integrado (Eneba, Instant Gaming, Amazon).
 */
import { Image } from 'astro:assets';
import enebaLogoImg from '../assets/images/afiliados/eneba-logo.png';
import igLogoImg from '../assets/images/afiliados/instant-gaming-logo.svg';
import amazonLogoImg from '../assets/images/afiliados/amazon-logo.png';

// ENLACES DE AFILIADOS (Modificables - Directos a contenido WoW)
const ENEBA_URL = "https://www.eneba.com/es/store/world-of-warcraft?af_id=wowgameres";
const INSTANT_GAMING_URL = "https://www.instant-gaming.com/es/102-comprar-game-card-world-of-warcraft-60-dias/?igr=wowgameres";
const AMAZON_URL = "https://www.amazon.es/s?k=funko+pop+world+of+warcraft&tag=wowgameres-21";
---

<div class="affiliate-hub-container">
  <div class="hub-header">
    <div class="hub-badge">🛒 Apoya la Web</div>
    <h3 class="hub-title">Consigue tu Tiempo de Juego y Gaming Gear al mejor precio</h3>
    <p class="hub-subtitle">
      Comprando a través de estos enlaces nos ayudas a mantener las guías 100% actualizadas y libres de anuncios molestos. ¡Gracias por tu apoyo!
    </p>
  </div>

  <div class="hub-grid">
    <!-- ENEBA -->
    <a href={ENEBA_URL} target="_blank" rel="noopener noreferrer" class="hub-card eneba-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
            <Image src={enebaLogoImg} alt="Eneba" class="eneba-png-logo" />
            <span class="eneba-text-hub">eneba</span>
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-purple">Suscripciones y Saldo</span>
        <p class="card-desc">Tarjetas de saldo Battle.net, prepagos de WoW y claves de expansión con descuentos instantáneos.</p>
        <div class="hub-cta">
          Ver ofertas en Eneba
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>

    <!-- INSTANT GAMING -->
    <a href={INSTANT_GAMING_URL} target="_blank" rel="noopener noreferrer" class="hub-card ig-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
            <Image src={igLogoImg} alt="Instant Gaming" class="ig-svg-logo" />
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-orange">Tiempo de Juego Oficial</span>
        <p class="card-desc">Compra tiempo de juego de 30 o 60 días al instante, de forma 100% segura y sin esperas.</p>
        <div class="hub-cta">
          Ver en Instant Gaming
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>

    <!-- AMAZON -->
    <a href={AMAZON_URL} target="_blank" rel="noopener noreferrer" class="hub-card amazon-card">
      <div class="card-brand-visual">
         <div class="logo-wrapper">
            <Image src={amazonLogoImg} alt="Amazon" class="amazon-png-logo" />
         </div>
      </div>
      <div class="card-info">
        <span class="tag tag-yellow">Merch y Periféricos</span>
        <p class="card-desc">Libros del Lore oficial de Warcraft, novelas, figuras coleccionables y hardware para tu PC.</p>
        <div class="hub-cta">
          Ver en Amazon
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </div>
      </div>
    </a>
  </div>
</div>

<style>
  .affiliate-hub-container {
    max-width: 1100px;
    margin: 50px auto;
    padding: 30px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 5;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  }

  html:not(.dark-mode) .affiliate-hub-container {
    background: rgba(255, 255, 255, 0.7);
    border: 1.5px solid rgba(106, 13, 173, 0.22);
    box-shadow: 0 15px 35px rgba(106, 13, 173, 0.05);
  }

  .hub-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 35px;
  }

  .hub-badge {
    display: inline-block;
    background: rgba(187, 159, 255, 0.1);
    border: 1px solid rgba(187, 159, 255, 0.2);
    color: #bb9fff;
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
  }

  html:not(.dark-mode) .hub-badge {
    background: rgba(106, 13, 173, 0.06);
    border-color: rgba(106, 13, 173, 0.15);
    color: var(--primary-purple);
  }

  .hub-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
    border: none;
    padding: 0;
  }

  html:not(.dark-mode) .hub-title {
    color: var(--text-dark);
  }

  .hub-subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }

  html:not(.dark-mode) .hub-subtitle {
    color: rgba(0, 0, 0, 0.65);
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    text-decoration: none;
    color: white;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    overflow: hidden;
    position: relative;
  }

  html:not(.dark-mode) .hub-card {
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(106, 13, 173, 0.16);
    color: var(--text-dark);
    box-shadow: 0 4px 12px rgba(106, 13, 173, 0.02);
  }

  /* Eneba Brand Color Theme */
  .eneba-card:hover {
    transform: translateY(-5px);
    border-color: rgba(175, 82, 222, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(175, 82, 222, 0.04));
    box-shadow: 0 10px 25px rgba(175, 82, 222, 0.15);
  }

  .eneba-card:hover .hub-cta {
    color: #c586ff;
  }

  html:not(.dark-mode) .eneba-card:hover {
    background: linear-gradient(to bottom, #ffffff, rgba(175, 82, 222, 0.05));
    border-color: rgba(175, 82, 222, 0.55);
    box-shadow: 0 10px 25px rgba(175, 82, 222, 0.08);
  }

  html:not(.dark-mode) .eneba-card:hover .hub-cta {
    color: #8b1eb2;
  }

  /* Instant Gaming Brand Color Theme */
  .ig-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 100, 0, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(255, 100, 0, 0.04));
    box-shadow: 0 10px 25px rgba(255, 100, 0, 0.15);
  }

  .ig-card:hover .hub-cta {
    color: #ff8533;
  }

  html:not(.dark-mode) .ig-card:hover {
    background: linear-gradient(to bottom, #ffffff, rgba(255, 100, 0, 0.05));
    border-color: rgba(255, 100, 0, 0.55);
    box-shadow: 0 10px 25px rgba(255, 100, 0, 0.08);
  }

  html:not(.dark-mode) .ig-card:hover .hub-cta {
    color: #e65100;
  }

  /* Amazon Brand Color Theme */
  .amazon-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 153, 0, 0.5);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), rgba(255, 153, 0, 0.04));
    box-shadow: 0 10px 25px rgba(255, 153, 0, 0.15);
  }

  .amazon-card:hover .hub-cta {
    color: #ffb84d;
  }

  html:not(.dark-mode) .amazon-card:hover {
    background: linear-gradient(to bottom, #ffffff, rgba(255, 153, 0, 0.05));
    border-color: rgba(255, 153, 0, 0.55);
    box-shadow: 0 10px 25px rgba(255, 153, 0, 0.08);
  }

  html:not(.dark-mode) .amazon-card:hover .hub-cta {
    color: #b36b00;
  }

  .card-brand-visual {
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background: #141124; /* Always dark to ensure white brand logos are perfectly visible */
  }

  html:not(.dark-mode) .card-brand-visual {
    border-bottom: 1px solid rgba(106, 13, 173, 0.08);
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.3s ease;
  }

  .hub-card:hover .logo-wrapper {
    transform: scale(1.05);
  }

  /* Logos styling */
  .eneba-png-logo {
    max-height: 35px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(154, 0, 230, 0.15));
  }

  .eneba-text-hub {
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    letter-spacing: -1.3px;
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
  }

  .ig-svg-logo {
    max-height: 48px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(255, 100, 0, 0.15));
  }

  .amazon-png-logo {
    max-height: 42px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(255, 153, 0, 0.15));
  }

  .card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    width: fit-content;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .tag-purple {
    background: rgba(175, 82, 222, 0.15);
    color: #d39eff;
  }

  html:not(.dark-mode) .tag-purple {
    background: rgba(175, 82, 222, 0.12);
    color: #7b1fa2;
  }

  .tag-orange {
    background: rgba(255, 100, 0, 0.15);
    color: #ff944d;
  }

  html:not(.dark-mode) .tag-orange {
    background: rgba(255, 100, 0, 0.12);
    color: #e65100;
  }

  .tag-yellow {
    background: rgba(255, 153, 0, 0.15);
    color: #ffc266;
  }

  html:not(.dark-mode) .tag-yellow {
    background: rgba(255, 153, 0, 0.12);
    color: #b36b00;
  }

  .card-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
    flex: 1;
  }

  html:not(.dark-mode) .card-desc {
    color: rgba(0, 0, 0, 0.7);
  }

  .hub-cta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  html:not(.dark-mode) .hub-cta {
    color: var(--primary-purple);
  }

  .hub-cta svg {
    transition: transform 0.3s ease;
  }

  .hub-card:hover .hub-cta svg {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .affiliate-hub-container {
      padding: 20px;
    }
    .card-brand-visual {
      height: 90px;
    }
  }
</style>
