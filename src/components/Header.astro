---
import { Image } from "astro:assets";
import logoWhite from "../assets/images/WOWGamerES_Logo_white.webp";
import logoBlack from "../assets/images/WOWGamerES_Logo_black.webp";
---
<header class="main-header">
    <div class="header-top-row">
        <section class="logo">
            <a href="/">
                <Image src={logoWhite} id="logo-white" alt="WOWGamerES Logo" width={180} height={45} format="avif" loading="eager" class="logo-img logo-white" />
                <Image src={logoBlack} id="logo-black" alt="WOWGamerES Logo" width={180} height={45} format="avif" loading="eager" class="logo-img logo-black" />
            </a>
        </section>

        <div class="search-container">
            <input type="text" id="quickSearch" placeholder="Buscar guía (ej: Joyería TBC)..." autocomplete="off">
            <ul id="searchResults" class="search-results" style="display: none;"></ul>
        </div>
        
        <nav class="main-nav">
            <ul>
                <li>
                  <a href="/" data-i18n="nav_home" aria-label="Inicio" title="Inicio" class="hearthstone-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="minimal-icon hearthstone-icon">
                      <!-- Tejado puntiagudo -->
                      <path d="M3 11L12 3L21 11"/>
                      <!-- Estructura de la casa -->
                      <path d="M5 10v10h14V10"/>
                      <!-- Puerta con arco medieval -->
                      <path d="M10 22v-5a2 2 0 0 1 4 0v5"/>
                      <!-- Chimenea -->
                      <line x1="18" y1="4" x2="18" y2="8"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="/noticias/" data-i18n="nav_news" aria-label="Noticias" title="Noticias" class="news-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="minimal-icon news-icon">
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                      <path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="/donar/" aria-label="Donar y Apoyar" title="Apoyar la Web" class="donate-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="minimal-icon donate-icon">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <button id="darkModeToggle" aria-label="Cambiar tema">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="theme-icon moon">
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="theme-icon sun">
                      <circle cx="12" cy="12" r="4"/>
                      <line x1="12" y1="2" x2="12" y2="5"/>
                      <line x1="12" y1="19" x2="12" y2="22"/>
                      <line x1="2" y1="12" x2="5" y2="12"/>
                      <line x1="19" y1="12" x2="22" y2="12"/>
                      <line x1="4.93" y1="4.93" x2="6.76" y2="6.76"/>
                      <line x1="17.24" y1="17.24" x2="19.07" y2="19.07"/>
                      <line x1="4.93" y1="19.07" x2="6.76" y2="17.24"/>
                      <line x1="17.24" y1="6.76" x2="19.07" y2="4.93"/>
                    </svg>
                  </button>
                </li>
            </ul>
        </nav>
    </div>
    <style>
        .logo-img {
            max-width: 100%;
            height: auto;
        }
        .logo-white { display: none; }
        .logo-black { display: block; }

        :global(.dark-mode) .logo-white { display: block; }
        :global(.dark-mode) .logo-black { display: none; }

        @media (max-width: 768px) {
            .logo-img { width: 250px; }
        }
    </style>
</header>

<script>
  (function() {
    const toggle = document.getElementById('darkModeToggle');

    function applyTheme(isDark: boolean) {
      if (isDark) {
        document.documentElement.classList.add('dark-mode');
      } else {
        document.documentElement.classList.remove('dark-mode');
      }
    }

    // Inicialización
    applyTheme(document.documentElement.classList.contains('dark-mode'));

    // Scroll listener para redimensionar la cabecera flotante
    const header = document.querySelector('.main-header');
    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 20) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', handleScroll);
      handleScroll(); // Check inicial
    }

    if (toggle) {
      toggle.addEventListener('click', (event) => {
        const isDark = !document.documentElement.classList.contains('dark-mode');
        
        // Si el navegador no soporta transiciones de vista de forma nativa
        if (!(document as any).startViewTransition) {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          applyTheme(isDark);
          return;
        }

        const x = event.clientX;
        const y = event.clientY;
        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );

        const transition = (document as any).startViewTransition(() => {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          applyTheme(isDark);
        });

        transition.ready.then(() => {
          const clipPath = [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`
          ];
          document.documentElement.animate(
            {
              clipPath: isDark ? clipPath : [...clipPath].reverse()
            },
            {
              duration: 400,
              easing: 'ease-in-out',
              pseudoElement: isDark ? '::view-transition-new(root)' : '::view-transition-old(root)'
            }
          );
        });
      });
    }

    // Escuchar cambios en otras pestañas
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') {
        applyTheme(e.newValue === 'dark');
      }
    });

    const searchInput = document.getElementById('quickSearch') as HTMLInputElement;
    const resultsList = document.getElementById('searchResults');

    const professions = [
      { id: 'alquimia', name: 'Alquimia' },
      { id: 'encantamiento', name: 'Encantamiento' },
      { id: 'herreria', name: 'Herrería' },
      { id: 'ingenieria', name: 'Ingeniería' },
      { id: 'inscripcion', name: 'Inscripción' },
      { id: 'joyeria', name: 'Joyería' },
      { id: 'peleteria', name: 'Peletería' },
      { id: 'sastreria', name: 'Sastrería' },
      { id: 'mineria', name: 'Minería' },
      { id: 'herboristeria', name: 'Herboristería' },
      { id: 'desuello', name: 'Desuello' },
      { id: 'pesca', name: 'Pesca' },
      { id: 'cocina', name: 'Cocina' },
      { id: 'arqueologia', name: 'Arqueología' },
      { id: 'primeros-auxilios', name: 'Primeros Auxilios' }
    ];

    const expansions = [
      { id: 'vanilla', name: 'Vanilla (Classic)', alias: ['classic'] },
      { id: 'tbc', name: 'Terrallende (TBC)', alias: ['tbc', 'burning crusade', 'outland'] },
      { id: 'wotlk', name: 'Rasganorte (WotLK)', alias: ['wotlk', 'lich king', 'northrend'] },
      { id: 'cata', name: 'Cataclismo', alias: ['cata', 'cataclysm'] },
      { id: 'mop', name: 'Pandaria (MoP)', alias: ['mop', 'mist of pandaria'] },
      { id: 'wod', name: 'Draenor (WoD)', alias: ['wod', 'warlords'] },
      { id: 'legion', name: 'Legión', alias: ['legion'] },
      { id: 'bfa', name: 'Battle for Azeroth (BfA)', alias: ['bfa'] },
      { id: 'sl', name: 'Shadowlands', alias: ['sl'] },
      { id: 'df', name: 'Dragonflight', alias: ['df'] },
      { id: 'tww', name: 'The War Within', alias: ['tww', 'war within'] },
      { id: 'midnight', name: 'Midnight', alias: ['midnight'] }
    ];

    const searchableIndex: { title: string, url: string, keywords: string[] }[] = [];
    professions.forEach(p => {
      expansions.forEach(e => {
        searchableIndex.push({
          title: `${p.name} - ${e.name}`,
          url: `/guias/${p.id}/${e.id}/`,
          keywords: [p.name.toLowerCase(), e.name.toLowerCase(), ... (e.alias || [])]
        });
      });
    });

    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase().trim();
      if (!resultsList) return;

      if (val.length < 2) {
        resultsList.style.display = 'none';
        return;
      }

      const searchTerms = val.split(/\s+/);
      const filtered = searchableIndex.filter(item => {
        const itemText = (item.title + ' ' + item.keywords.join(' ')).toLowerCase();
        return searchTerms.every(term => itemText.includes(term));
      }).slice(0, 20);

      if (filtered.length > 0) {
        resultsList.innerHTML = filtered.map(item => `
          <li><a href="${item.url}">${item.title}</a></li>
        `).join('');
        resultsList.style.display = 'block';
      } else {
        resultsList.style.display = 'none';
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target as Node) && !resultsList?.contains(e.target as Node)) {
        if (resultsList) resultsList.style.display = 'none';
      }
    });
  })();
</script>
